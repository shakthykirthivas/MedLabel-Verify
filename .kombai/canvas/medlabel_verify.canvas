y-24 overflow-hidden relative\" id=\"hero-section\" data-kid=\"25\">\n    <div class=\"swiss-grid items-end\" data-kid=\"26\">\n      <div class=\"col-span-8\" id=\"hero-main-content\" data-kid=\"27\">\n        <div class=\"mb-8 flex items-center gap-3 hero-animate-item\" data-kid=\"28\">\n          <span class=\"px-2 py-0.5 border border-[var(--k-color-primary)] text-[10px] font-bold uppercase\" data-kid=\"29\">Report ID: MLV-8829-X</span>\n          <span class=\"text-[10px] font-medium uppercase text-[var(--k-color-text-muted)] tracking-wider\" data-kid=\"30\">Generated: Oct 24, 2026 — 14:32 GMT</span>\n        </div>\n        <h1 class=\"text-[120px] font-extrabold tracking-tighter leading-[0.8] text-[var(--k-color-primary)] mb-4 hero-animate-item\" id=\"score-text\" data-kid=\"31\">\n          <span id=\"score-number\" data-kid=\"32\">0</span>% <span class=\"text-[var(--k-color-accent)]\" data-kid=\"33\">COMPLIANT</span>\n        </h1>\n        <p class=\"text-xl font-light text-[var(--k-color-text-muted)] max-w-xl hero-animate-item\" data-kid=\"34\">\n          Deep-scan verification complete. 48 regulatory checkpoints analyzed across 3 global jurisdictions.\n        </p>\n      </div>\n      <div class=\"col-span-4 pb-4\" data-kid=\"35\">\n        <div class=\"p-6 border border-[var(--k-color-primary)]/10 bg-[var(--k-color-bg-surface)] relative\" data-kid=\"36\">\n          <div class=\"flex justify-between items-center mb-4\" data-kid=\"37\">\n            <span class=\"text-[10px] font-bold uppercase tracking-widest\" data-kid=\"38\">Verification Status</span>\n            <span class=\"text-[10px] font-mono font-bold text-[var(--k-color-accent)]\" data-kid=\"39\">CRITICAL_MET</span>\n          </div>\n          <div class=\"w-full h-8 bg-[var(--k-color-border)] relative overflow-hidden\" data-kid=\"40\">\n            <div class=\"scan-overlay\" data-kid=\"41\">\n              <div class=\"scan-line\" id=\"hero-scan-line\" data-kid=\"42\"></div>\n           