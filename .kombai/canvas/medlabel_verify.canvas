p@3/dist/ScrollTrigger.min.js\" data-kid=\"243\"></script>\n<script data-kid=\"244\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Initial setup\n  window.addEventListener('DOMContentLoaded', () => {\n    // Hero Animations\n    const tl = gsap.timeline({ delay: 0.2 });\n    \n    tl.from('.hero-animate-item', {\n      opacity: 0,\n      y: 30,\n      duration: 1,\n      stagger: 0.2,\n      ease: \"power4.out\"\n    });\n\n    // Score Counter\n    const scoreObj = { val: 0 };\n    gsap.to(scoreObj, {\n      val: 94,\n      duration: 2,\n      ease: \"power2.out\",\n      onUpdate: () => {\n        document.getElementById('score-number').innerText = Math.floor(scoreObj.val);\n      }\n    });\n\n    // Progress Bar\n    gsap.to('#hero-progress-bar', {\n      width: '94%',\n      duration: 1.5,\n      ease: \"expo.out\",\n      delay: 0.8\n    });\n\n    // Scan line animation\n    gsap.to('#hero-scan-line', {\n      top: '100%',\n      duration: 4,\n      repeat: -1,\n      yoyo: true,\n      ease: \"power1.inOut\"\n    });\n\n    // Ledger Row Stagger\n    gsap.from('.ledger-row', {\n      scrollTrigger: {\n        trigger: '#ledger-container',\n        start: 'top 80%',\n      },\n      opacity: 0,\n      y: 20,\n      duration: 0.8,\n      stagger: 0.1,\n      ease: \"power2.out\"\n    });\n\n    // Jurisdiction Card Entrance\n    gsap.from('.jurisdiction-card', {\n      scrollTrigger: {\n        trigger: '.jurisdiction-sidebar',\n        start: 'top 80%',\n      },\n      opacity: 0,\n      x: 30,\n      duration: 1,\n      stagger: 0.2,\n      ease: \"power3.out\"\n    });\n  });\n</script>\n",
