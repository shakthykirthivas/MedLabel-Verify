a-kid=\"215\">\n          <h4 class=\"text-[11px] font-bold uppercase tracking-[0.4em] text-[#2A3439]\" data-kid=\"216\">Registry</h4>\n          <ul class=\"flex flex-col gap-4 text-[11px] font-bold text-[#2A3439]/70 uppercase tracking-widest\" data-kid=\"217\">\n            <li data-kid=\"218\"><a href=\"#\" class=\"hover:text-[#00356B] hover:translate-x-1 transition-all inline-block\" data-kid=\"219\">Active Specs</a></li>\n            <li data-kid=\"220\"><a href=\"#\" class=\"hover:text-[#00356B] hover:translate-x-1 transition-all inline-block\" data-kid=\"221\">Legacy Data</a></li>\n            <li data-kid=\"222\"><a href=\"#\" class=\"hover:text-[#00356B] hover:translate-x-1 transition-all inline-block\" data-kid=\"223\">Draft Library</a></li>\n            <li data-kid=\"224\"><a href=\"#\" class=\"hover:text-[#00356B] hover:translate-x-1 transition-all inline-block\" data-kid=\"225\">Delta Archive</a></li>\n          </ul>\n        </div>\n\n        <div class=\"flex flex-col gap-6\" data-kid=\"226\">\n          <h4 class=\"text-[11px] font-bold uppercase tracking-[0.4em] text-[#2A3439]\" data-kid=\"227\">Institutional</h4>\n          <ul class=\"flex flex-col gap-4 text-[11px] font-bold text-[#2A3439]/70 uppercase tracking-widest\" data-kid=\"228\">\n            <li data-kid=\"229\"><a href=\"#\" class=\"hover:text-[#00356B] hover:translate-x-1 transition-all inline-block\" data-kid=\"230\">Privacy Protocol</a></li>\n            <li data-kid=\"231\"><a href=\"#\" class=\"hover:text-[#00356B] hover:translate-x-1 transition-all inline-block\" data-kid=\"232\">Trust Report</a></li>\n            <li data-kid=\"233\"><a href=\"#\" class=\"hover:text-[#00356B] hover:translate-x-1 transition-all inline-block\" data-kid=\"234\">Compliance API</a></li>\n            <li data-kid=\"235\"><a href=\"#\" class=\"hover:text-[#00356B] hover:translate-x-1 transition-all inline-block\" data-kid=\"236\">Legal Spec</a></li>\n          </ul>\n        </div>\n\n        <div class=\"flex flex-col gap-6\" data-kid=\"237\">\n          <h4 class=\"text-[11px] font-bold uppercase tracking-[0.4em] text-[#2A3439]\" data-kid=\"238\">Node Status</h4>\n          <div class=\"flex flex-col gap-4 text-[10px] font-bold text-[#2A3439]/70 uppercase tracking-[0.2em]\" data-kid=\"239\">\n            <div class=\"flex justify-between items-center border-b border-[#2A3439]/10 pb-2\" data-kid=\"240\">\n              <span data-kid=\"241\">ZRH_Primary</span>\n              <span class=\"text-green-600\" data-kid=\"242\">Active</span>\n            </div>\n            <div class=\"flex justify-between items-center border-b border-[#2A3439]/10 pb-2\" data-kid=\"243\">\n              <span data-kid=\"244\">FRA_Secondary</span>\n              <span class=\"text-green-600\" data-kid=\"245\">Active</span>\n            </div>\n            <div class=\"flex justify-between items-center border-b border-[#2A3439]/10 pb-2\" data-kid=\"246\">\n              <span data-kid=\"247\">NYC_Edge</span>\n              <span class=\"text-amber-700\" data-kid=\"248\">Latency</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n    \n    <div class=\"swiss-grid pt-12\" data-kid=\"249\">\n      <div class=\"col-span-6 text-[10px] font-bold text-[#2A3439]/60 uppercase tracking-[0.3em]\" data-kid=\"250\">\n        &copy; 2026 MedLabel Verify INC. Precision Compliance.\n      </div>\n      <div class=\"col-span-6 text-right text-[10px] font-bold text-[#2A3439]/60 uppercase tracking-[0.3em]\" data-kid=\"251\">\n        Status: <span class=\"text-green-700\" data-kid=\"252\">Fully Operational</span> &middot; Ver: 4.2.1-stable\n      </div>\n    </div>\n  </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"253\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"254\"></script>\n\n<script data-kid=\"255\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Entrance Animations\n  window.addEventListener('load', () => {\n    const tl = gsap.timeline({ defaults: { ease: \"power4.out\" } });\n\n    tl.from('.hero-anim', {\n      y: 40,\n      opacity: 0,\n      duration: 1,\n      stagger: 0.1,\n    })\n    .from('#index-section', {\n      scaleX: 0,\n      transformOrigin: \"left\",\n      duration: 1,\n    }, \"-=0.5\")\n    .from('.ledger-row', {\n      y: 20,\n      opacity: 0,\n      duration: 0.8,\n      stagger: 0.05,\n    }, \"-=0.8\")\n    .from('.sidebar-item', {\n      x: 20,\n      opacity: 0,\n      duration: 0.8,\n      stagger: 0.1,\n    }, \"-=1\");\n\n    // Counter animation for active rules\n    const statObj = { val: 0 };\n    gsap.to(statObj, {\n      val: 24812,\n      duration: 2,\n      ease: \"power2.out\",\n      onUpdate: () => {\n        document.getElementById('stat-count').innerText = Math.floor(statObj.val).toLocaleString();\n      }\n    });\n\n  });\n\n  // Scroll revealed items\n  gsap.from('#ledger-hud', {\n    scrollTrigger: {\n      trigger: '#ledger-hud',\n      start: 'top 95%',\n    },\n    y: 30,\n    opacity: 0,\n    duration: 1,\n    ease: \"expo.out\"\n  });\n\n</script>\n",
