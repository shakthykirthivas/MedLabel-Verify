      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=IBM+Plex+Sans:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --k-color-primary: #2A3439;\n    --k-color-secondary: #00356B;\n    --k-color-bg-page: #FFFFFF;\n    --k-color-bg-surface: #FAFAFA;\n    --k-color-text-primary: #2A3439;\n    --k-color-text-muted: #64748B;\n    --k-color-border: #E2E8F0;\n    --k-color-accent: #00356B;\n    --k-font-family-heading: 'Plus Jakarta Sans', sans-serif;\n    --k-font-family-body: 'IBM Plex Sans', sans-serif;\n  }\n\n  body {\n    background-color: var(--k-color-bg-page);\n    color: var(--k-color-text-primary);\n    font-family: var(--k-font-family-body);\n    -webkit-font-smoothing: antialiased;\n    overflow-x: clip;\n  }\n\n  .swiss-grid {\n    display: grid;\n    grid-template-columns: repeat(12, 1fr);\n    gap: 32px;\n    max-width: 1440px;\n    margin: 0 auto;\n    padding: 0 40px;\n  }\n\n  .headline-tight {\n    letter-spacing: -0.04em;\n    line-height: 0.85;\n  }\n\n  .hairline {\n    border: 0;\n    border-top: 1px solid rgba(42, 52, 57, 0.2);\n  }\n\n  .monospace-font {\n    font-family: 'IBM Plex Mono', monospace;\n  }\n\n  /* Custom Scrollbar */\n  ::-webkit-scrollbar {\n    width: 6px;\n  }\n  ::-webkit-scrollbar-track {\n    background: #f1f1f1;\n  }\n  ::-webkit-scrollbar-thumb {\n    background: #2A3439;\n  }\n\n  /* Scanning HUD Scanline - Static Technical Element */\n  .hud-accent-line {\n    width: 100%;\n    height: 1px;\n    background: var(--k-color-secondary);\n    position: relative;\n    overflow: hidden;\n  }\n</style>\n\n<div class=\"min-h-screen\" data-kid=\"1\">\n  \n  <nav class=\"sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-[#2A3439]/20\" data-kid=\"2\">\n    <div class=\"swiss-grid py-4 items-center\" data-kid=\"3\">\n      <div class=\"col-span-3 flex items-center gap-3 group cursor-pointer\" data-kid=\"4\">\n        <div class=\"w-9 h-9 bg-[#2A3439] flex items-center justify-center text-white font-bold text-xl\" data-kid=\"5\">M</div>\n        <span class=\"font-['Plus_Jakarta_Sans'] font-extrabold tracking-tighter text-2xl uppercase text-[#2A3439]\" data-kid=\"6\">\n          MEDLABEL<span class=\"font-light text-[#2A3439]/60\" data-kid=\"7\">VERIFY</span>\n        </span>\n      </div>\n      <div class=\"col-span-6 flex justify-center gap-12 font-semibold text-[10px] tracking-[0.2em] uppercase text-[#2A3439]/60\" data-kid=\"8\">\n        <a href=\"#\" class=\"hover:text-[#00356B] transition-colors\" data-kid=\"9\">Framework</a>\n        <a href=\"#\" class=\"hover:text-[#00356B] transition-colors text-[#2A3439]\" data-kid=\"10\">Standards Library</a>\n        <a href=\"#\" class=\"hover:text-[#00356B] transition-colors\" data-kid=\"11\">Technical Docs</a>\n        <a href=\"#\" class=\"hover:text-[#00356B] transition-colors\" data-kid=\"12\">Audit logs</a>\n      </div>\n      <div class=\"col-span-3 flex justify-end\" data-kid=\"13\">\n        <div class=\"relative w-full max-w-[240px]\" data-kid=\"14\">\n          <input type=\"text\" placeholder=\"REF_SEARCH_INPUT\" class=\"monospace-font w-full text-[10px] font-medium py-2.5 px-4 bg-[#FAFAFA] border border-[#2A3439]/20 focus:outline-hidden focus:border-[#2A3439] transition-all uppercase tracking-widest\" data-kid=\"15\">\n          <i class=\"ti ti-search absolute right-3 top-1/2 -translate-y-1/2 text-[#2A3439]/60 text-sm\" data-kid=\"16\"></i>\n        </div>\n      </div>\n    </div>\n  </nav>\n\n  \n  <header class=\"pt-24 pb-12\" data-kid=\"17\">\n    <div class=\"swiss-grid items-start\" data-kid=\"18\">\n      <div class=\"col-span-8\" data-kid=\"19\">\n        <div class=\"mb-10 flex items-center gap-4 hero-anim\" data-kid=\"20\">\n          <span class=\"px-3 py-1 bg-[#2A3439] text-white text-[10px] font-bold uppercase tracking-[0.4em]\" data-kid=\"21\">Index v4.1.2</span>\n          <span class=\"text-[11px] font-bold text-[#2A3439]/70 uppercase tracking-widest\" data-kid=\"22\">Global Regulatory Repository</span>\n        </div>\n        <h1 class=\"text-[96px] font-['Plus_Jakarta_Sans'] font-extrabold headline-tight text-[#2A3439] mb-10 hero-anim\" data-kid=\"23\">\n          Absolute Standards<br data-kid=\"24\">Library.\n        </h1>\n        <div class=\"grid grid-cols-8 gap-8 hero-anim\" data-kid=\"25\">\n          <div class=\"col-span-5\" data-kid=\"26\">\n            <p class=\"text-xl text-[#2A3439]/80 font-light leading-relaxed\" data-kid=\"27\">\n              Deterministic verification for ISO, FDA, and EU MDR requirements. Our repository acts as the single source of truth for clinical device compliance.\n            </p>\n          </div>\n          <div class=\"col-span-3 pt-2 border-l border-[#2A3439]/20 pl-8\" data-kid=\"28\">\n            <span class=\"block text-[10px] font-bold uppercase tracking-[0.2em] text-[#2A3439]/60 mb-2\" data-kid=\"29\">Live Registry Status</span>\n            <div class=\"flex items-center gap-3\" data-kid=\"30\">\n              <div class=\"w-2.5 h-2.5 rounded-full bg-green-600\" data-kid=\"31\"></div>\n              <span class=\"monospace-font text-xs font-bold uppercase\" data-kid=\"32\">Operational</span>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div class=\"col-span-4 bg-[#FAFAFA] border border-[#2A3439]/20 p-10 flex flex-col gap-8 hero-anim\" data-kid=\"33\">\n        <div data-kid=\"34\">\n          <span class=\"block text-[10px] font-bold uppercase tracking-widest text-[#2A3439]/60 mb-3\" data-kid=\"35\">Database Density</span>\n          <div class=\"flex items-baseline gap-2\" data-kid=\"36\">\n            <span class=\"text-6xl font-extrabold tracking-tighter\" id=\"stat-count\" data-kid=\"37\">0</span>\n            <span class=\"monospace-font text-xs font-bold text-[#00356B]\" data-kid=\"38\">RULES</span>\n          </div>\n        </div>\n        <div class=\"pt-8 border-t border-[#2A3439]/10\" data-kid=\"39\">\n          <span class=\"block text-[10px] font-bold uppercase tracking-widest text-[#2A3439]/60 mb-4\" data-kid=\"40\">Last Sync Verification</span>\n          <div class=\"flex flex-col gap-2\" data-kid=\"41\">\n            <div class=\"flex justify-between items-center text-[10px] font-bold uppercase\" data-kid=\"42\">\n              <span data-kid=\"43\">Sync Coverage</span>\n              <span class=\"text-[#00356B]\" data-kid=\"44\">99.98%</span>\n            </div>\n            <div class=\"w-full h-1 bg-[#2A3439]/10\" data-kid=\"45\">\n              <div class=\"w-[99.98%] h-full bg-[#00356B]\" data-kid=\"46\"></div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  \n  <section class=\"border-y border-[#2A3439]/20 py-8 mb-12\" id=\"index-section\" data-kid=\"47\">\n    <div class=\"swiss-grid items-center\" data-kid=\"48\">\n      <div class=\"col-span-12 flex items-center gap-8\" data-kid=\"49\">\n        <span class=\"monospace-font text-[11px] font-bold uppercase tracking-[0.3em] text-[#2A3439]/60\" data-kid=\"50\">Select Authority</span>\n        <div class=\"flex\" data-kid=\"51\">\n          <button class=\"w-12 h-10 bg-[#2A3439] text-white text-xs font-bold tracking-widest border border-[#2A3439]\" data-kid=\"52\">ALL</button>\n          <button class=\"w-12 h-10 flex items-center justify-center hover:bg-[#F1F5F9] transition-colors text-xs font-bold tracking-widest border border-[#2A3439]/20 -ml-px\" data-kid=\"53\">A</button>\n          <button class=\"w-12 h-10 flex items-center justify-center hover:bg-[#F1F5F9] transition-colors text-xs font-bold tracking-widest border border-[#2A3439]/20 -ml-px\" data-kid=\"54\">B</button>\n          <button class=\"w-12 h-10 flex items-center justify-center hover:bg-[#F1F5F9] transition-colors text-xs font-bold tracking-widest border border-[#2A3439]/20 -ml-px\" data-kid=\"55\">C</button>\n          <button class=\"w-12 h-10 flex items-center justify-center hover:bg-[#F1F5F9] transition-colors text-xs font-bold tracking-widest border border-[#2A3439]/20 -ml-px\" data-kid=\"56\">D</button>\n          <button class=\"w-12 h-10 flex items-center justify-center hover:bg-[#F1F5F9] transition-colors text-xs font-bold tracking-widest border border-[#2A3439]/20 -ml-px text-[#2A3439]/30\" data-kid=\"57\">E</button>\n          <button class=\"w-12 h-10 flex items-center justify-center hover:bg-[#F1F5F9] transition-colors text-xs font-bold tracking-widest border border-[#2A3439]/20 -ml-px\" data-kid=\"58\">F</button>\n          <button class=\"w-12 h-10 flex items-center justify-center hover:bg-[#F1F5F9] transition-colors text-xs font-bold tracking-widest border border-[#2A3439]/20 -ml-px\" data-kid=\"59\">G</button>\n          <div class=\"w-12 h-10 flex items-center justify-center text-[#2A3439]/30 font-bold -ml-px border border-[#2A3439]/20 uppercase text-[9px]\" data-kid=\"60\">etc</div>\n          <button class=\"w-12 h-10 flex items-center justify-center hover:bg-[#F1F5F9] transition-colors text-xs font-bold tracking-widest border border-[#2A3439]/20 -ml-px\" data-kid=\"61\">Z</button>\n        </div>\n        <div class=\"ml-auto flex items-center gap-6\" data-kid=\"62\">\n          <span class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-[#2A3439]/70\" data-kid=\"63\">Filter Scope</span>\n          <div class=\"flex gap-2\" data-kid=\"64\">\n            <span class=\"px-3 py-1 bg-green-100 border border-green-200 text-[10px] font-bold text-green-800 tracking-widest uppercase\" data-kid=\"65\">Verified</span>\n            <span class=\"px-3 py-1 bg-amber-100 border border-amber-200 text-[10px] font-bold text-amber-800 tracking-widest uppercase\" data-kid=\"66\">Draft</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <main class=\"pb-16\" data-kid=\"67\">\n    <div class=\"swiss-grid\" data-kid=\"68\">\n      \n      <div class=\"col-span-9\" id=\"ledger-view\" data-kid=\"69\">\n        <div class=\"bg-white border border-[#2A3439]/20 p-12 relative\" data-kid=\"70\">\n          \n          <div class=\"flex justify-between items-end mb-12 pb-10 border-b border-[#2A3439]\" data-kid=\"71\">\n            <div data-kid=\"72\">\n              <div class=\"flex items-center gap-4 mb-4\" data-kid=\"73\">\n                <span class=\"bg-[#00356B] text-white text-[10px] font-bold px-3 py-1 tracking-[0.2em] uppercase\" data-kid=\"74\">FDA 21 CFR 801</span>\n                <span class=\"text-[11px] font-bold text-[#2A3439]/70 uppercase tracking-widest\" data-kid=\"75\">Core Technical Standards</span>\n              </div>\n              <h2 class=\"text-4xl font-['Plus_Jakarta_Sans'] font-extrabold tracking-tight\" data-kid=\"76\">Compliance Ledger</h2>\n            </div>\n            <div class=\"text-right\" data-kid=\"77\">\n              <span class=\"block text-[10px] font-bold uppercase tracking-[0.2em] text-[#2A3439]/60 mb-2\" data-kid=\"78\">Revision Control</span>\n              <span class=\"block monospace-font text-xs font-bold text-[#2A3439]\" data-kid=\"79\">12 MAY 2026 // 14:20 GMT</span>\n            </div>\n          </div>\n\n          \n          <div class=\"overflow-x-auto\" data-kid=\"80\">\n            <table class=\"w-full text-left border-collapse table-fixed\" data-kid=\"81\">\n              <thead data-kid=\"82\">\n                <tr class=\"text-[11px] font-bold uppercase tracking-[0.3em] text-[#2A3439]/70 border-b border-[#2A3439]/20\" data-kid=\"83\">\n                  <th class=\"py-5 w-16\" data-kid=\"84\">ID</th>\n                  <th class=\"py-5 px-6\" data-kid=\"85\">Requirement Parameter</th>\n                  <th class=\"py-5 px-4 w-28\" data-kid=\"86\">Class</th>\n                  <th class=\"py-5 px-4 w-36\" data-kid=\"87\">Severity</th>\n                  <th class=\"py-5 text-right w-32\" data-kid=\"88\">Verification</th>\n                </tr>\n              </thead>\n              <tbody class=\"text-sm\" data-kid=\"89\">\n                \n                <tr class=\"border-b border-[#2A3439]/10 group ledger-row\" data-kid=\"90\">\n                  <td class=\"py-8 monospace-font text-[12px] font-medium text-[#2A3439]/60\" data-kid=\"91\">01.04</td>\n                  <td class=\"py-8 px-6\" data-kid=\"92\">\n                    <span class=\"block font-bold text-[#2A3439] mb-2 text-base\" data-kid=\"93\">Manufacturer Details</span>\n                    <p class=\"text-[13px] text-[#2A3439]/80 leading-relaxed font-light\" data-kid=\"94\">Name and primary place of business must be explicitly declared on all primary and secondary packaging.</p>\n                  </td>\n                  <td class=\"py-8 px-4\" data-kid=\"95\">\n                    <span class=\"text-[10px] font-bold px-2 py-1 bg-[#2A3439]/10 border border-[#2A3439]/20 uppercase\" data-kid=\"96\">All Dev</span>\n                  </td>\n                  <td class=\"py-8 px-4\" data-kid=\"97\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"98\">\n                      <div class=\"w-2.5 h-2.5 rounded-full bg-red-600\" data-kid=\"99\"></div>\n                      <span class=\"font-bold text-[11px] uppercase tracking-tight\" data-kid=\"100\">Critical</span>\n                    </div>\n                  </td>\n                  <td class=\"py-8 text-right font-bold text-[#00356B] monospace-font text-[11px] uppercase tracking-wider\" data-kid=\"101\">Automated</td>\n                </tr>\n                \n                <tr class=\"border-b border-[#2A3439]/10 group ledger-row\" data-kid=\"102\">\n                  <td class=\"py-8 monospace-font text-[12px] font-medium text-[#2A3439]/60\" data-kid=\"103\">01.12</td>\n                  <td class=\"py-8 px-6\" data-kid=\"104\">\n                    <span class=\"block font-bold text-[#2A3439] mb-2 text-base\" data-kid=\"105\">Statement of Intended Use</span>\n                    <p class=\"text-[13px] text-[#2A3439]/80 leading-relaxed font-light\" data-kid=\"106\">Full declaration of clinical intent required for all Class II/III diagnostic equipment. Cross-verified with 510(k) filings.</p>\n                  </td>\n                  <td class=\"py-8 px-4\" data-kid=\"107\">\n                    <span class=\"text-[10px] font-bold px-2 py-1 bg-[#2A3439]/10 border border-[#2A3439]/20 uppercase\" data-kid=\"108\">CL II/III</span>\n                  </td>\n                  <td class=\"py-8 px-4\" data-kid=\"109\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"110\">\n                      <div class=\"w-2.5 h-2.5 rounded-full bg-amber-600\" data-kid=\"111\"></div>\n                      <span class=\"font-bold text-[11px] uppercase tracking-tight\" data-kid=\"112\">High Risk</span>\n                    </div>\n                  </td>\n                  <td class=\"py-8 text-right font-bold text-[#00356B] monospace-font text-[11px] uppercase tracking-wider\" data-kid=\"113\">Ocr Match</td>\n                </tr>\n                \n                <tr class=\"border-b border-[#2A3439]/10 group ledger-row\" data-kid=\"114\">\n                  <td class=\"py-8 monospace-font text-[12px] font-medium text-[#2A3439]/60\" data-kid=\"115\">02.21</td>\n                  <td class=\"py-8 px-6\" data-kid=\"116\">\n                    <span class=\"block font-bold text-[#2A3439] mb-2 text-base\" data-kid=\"117\">Environmental Constraints</span>\n                    <p class=\"text-[13px] text-[#2A3439]/80 leading-relaxed font-light\" data-kid=\"118\">Explicit temperature, humidity, and pressure tolerances using ISO 15223-1 glyphs for standardized identification.</p>\n                  </td>\n                  <td class=\"py-8 px-4\" data-kid=\"119\">\n                    <span class=\"text-[10px] font-bold px-2 py-1 bg-[#2A3439]/10 border border-[#2A3439]/20 uppercase\" data-kid=\"120\">Cl I/II</span>\n                  </td>\n                  <td class=\"py-8 px-4\" data-kid=\"121\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"122\">\n                      <div class=\"w-2.5 h-2.5 rounded-full bg-[#2A3439]/80\" data-kid=\"123\"></div>\n                      <span class=\"font-bold text-[11px] uppercase tracking-tight\" data-kid=\"124\">Standard</span>\n                    </div>\n                  </td>\n                  <td class=\"py-8 text-right font-bold text-[#00356B] monospace-font text-[11px] uppercase tracking-wider\" data-kid=\"125\">Symbol Val</td>\n                </tr>\n                \n                <tr class=\"border-b border-[#2A3439]/10 group ledger-row\" data-kid=\"126\">\n                  <td class=\"py-8 monospace-font text-[12px] font-medium text-[#2A3439]/60\" data-kid=\"127\">04.09</td>\n                  <td class=\"py-8 px-6\" data-kid=\"128\">\n                    <span class=\"block font-bold text-[#2A3439] mb-2 text-base\" data-kid=\"129\">Territorial Translation</span>\n                    <p class=\"text-[13px] text-[#2A3439]/80 leading-relaxed font-light\" data-kid=\"130\">Specific linguistic overrides for non-English speaking US territories, including Puerto Rico and Guam. Must include Spanish localized labels.</p>\n                  </td>\n                  <td class=\"py-8 px-4\" data-kid=\"131\">\n                    <span class=\"text-[10px] font-bold px-2 py-1 bg-[#2A3439]/10 border border-[#2A3439]/20 uppercase\" data-kid=\"132\">All Dev</span>\n                  </td>\n                  <td class=\"py-8 px-4\" data-kid=\"133\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"134\">\n                      <div class=\"w-2.5 h-2.5 rounded-full bg-[#2A3439]/80\" data-kid=\"135\"></div>\n                      <span class=\"font-bold text-[11px] uppercase tracking-tight\" data-kid=\"136\">Standard</span>\n                    </div>\n                  </td>\n                  <td class=\"py-8 text-right font-bold text-[#00356B] monospace-font text-[11px] uppercase tracking-wider\" data-kid=\"137\">Geoloc Val</td>\n                </tr>\n              </tbody>\n            </table>\n          </div>\n\n          \n          <div class=\"mt-12 bg-[#2A3439] text-white px-8 py-8 flex justify-between items-center relative overflow-hidden\" id=\"ledger-hud\" data-kid=\"138\">\n            <div class=\"flex gap-12 relative z-20\" data-kid=\"139\">\n              <div class=\"border-l border-white/20 pl-4\" data-kid=\"140\">\n                <span class=\"block text-[10px] font-bold uppercase tracking-widest opacity-60 mb-2\" data-kid=\"141\">Sync Status</span>\n                <div class=\"flex items-center gap-3\" data-kid=\"142\">\n                  <div class=\"w-2 h-2 rounded-full bg-green-500\" data-kid=\"143\"></div>\n                  <span class=\"monospace-font text-[11px] font-bold uppercase\" data-kid=\"144\">Live_Active</span>\n                </div>\n              </div>\n              <div class=\"border-l border-white/20 pl-4\" data-kid=\"145\">\n                <span class=\"block text-[10px] font-bold uppercase tracking-widest opacity-60 mb-2\" data-kid=\"146\">Technical Hash</span>\n                <span class=\"monospace-font text-[11px] font-bold uppercase tracking-tighter\" data-kid=\"147\">SHA256:8B2F...4A1E</span>\n              </div>\n            </div>\n            <button class=\"relative z-20 bg-[#00356B] px-8 py-3 text-[11px] font-bold uppercase tracking-[0.3em] hover:bg-white hover:text-[#00356B] transition-colors border border-transparent hover:border-[#2A3439]\" data-kid=\"148\">Export Ledger Spec</button>\n          </div>\n        </div>\n      </div>\n\n      \n      <aside class=\"col-span-3\" id=\"sidebar-content\" data-kid=\"149\">\n        <div class=\"mb-12\" data-kid=\"150\">\n          <h3 class=\"text-[10px] font-bold uppercase tracking-[0.25em] text-[#2A3439] pb-4 border-b border-[#2A3439] mb-8\" data-kid=\"151\">Recently Updated</h3>\n          <div class=\"space-y-10\" data-kid=\"152\">\n            \n            <div class=\"group cursor-pointer sidebar-item relative pl-8\" data-kid=\"153\">\n              <span class=\"absolute left-0 top-1.5 font-['IBM_Plex_Mono'] text-[10px] text-[#2A3439]/30\" data-kid=\"154\">01</span>\n              <span class=\"block font-['IBM_Plex_Mono'] text-[10px] text-[#2A3439]/40 mb-2\" data-kid=\"155\">08 JUN 2026</span>\n              <h4 class=\"font-bold text-sm mb-2 group-hover:text-[#00356B] transition-colors leading-snug\" data-kid=\"156\">EU MDR 2017/745 Annex XVI</h4>\n              <p class=\"text-xs text-[#2A3439]/60 leading-relaxed mb-4\" data-kid=\"157\">New requirements for medical devices without an intended medical purpose.</p>\n              <div class=\"flex items-center gap-2 text-[9px] font-bold text-[#00356B] opacity-0 group-hover:opacity-100 transition-all -translate-x-2 group-hover:translate-x-0\" data-kid=\"158\">\n                <span data-kid=\"159\">VIEW TECHNICAL SPEC</span>\n                <i class=\"ti ti-arrow-right\" data-kid=\"160\"></i>\n              </div>\n            </div>\n            \n            <div class=\"group cursor-pointer sidebar-item relative pl-8\" data-kid=\"161\">\n              <span class=\"absolute left-0 top-1.5 font-['IBM_Plex_Mono'] text-[10px] text-[#2A3439]/30\" data-kid=\"162\">02</span>\n              <span class=\"block font-['IBM_Plex_Mono'] text-[10px] text-[#2A3439]/40 mb-2\" data-kid=\"163\">03 JUN 2026</span>\n              <h4 class=\"font-bold text-sm mb-2 group-hover:text-[#00356B] transition-colors leading-snug\" data-kid=\"164\">FDA QMSR Alignment</h4>\n              <p class=\"text-xs text-[#2A3439]/60 leading-relaxed mb-4\" data-kid=\"165\">Final rule amending 21 CFR Part 820 to incorporate ISO 13485:2016.</p>\n              <div class=\"flex items-center gap-2 text-[9px] font-bold text-[#00356B] opacity-0 group-hover:opacity-100 transition-all -translate-x-2 group-hover:translate-x-0\" data-kid=\"166\">\n                <span data-kid=\"167\">VIEW TECHNICAL SPEC</span>\n                <i class=\"ti ti-arrow-right\" data-kid=\"168\"></i>\n              </div>\n            </div>\n            \n            <div class=\"group cursor-pointer sidebar-item relative pl-8\" data-kid=\"169\">\n              <span class=\"absolute left-0 top-1.5 font-['IBM_Plex_Mono'] text-[10px] text-[#2A3439]/30\" data-kid=\"170\">03</span>\n              <span class=\"block font-['IBM_Plex_Mono'] text-[10px] text-[#2A3439]/40 mb-2\" data-kid=\"171\">28 MAY 2026</span>\n              <h4 class=\"font-bold text-sm mb-2 group-hover:text-[#00356B] transition-colors leading-snug\" data-kid=\"172\">TGA Australia UDI</h4>\n              <p class=\"text-xs text-[#2A3439]/60 leading-relaxed mb-4\" data-kid=\"173\">Release of the updated UDI sandbox environment for testing.</p>\n              <div class=\"flex items-center gap-2 text-[9px] font-bold text-[#00356B] opacity-0 group-hover:opacity-100 transition-all -translate-x-2 group-hover:translate-x-0\" data-kid=\"174\">\n                <span data-kid=\"175\">VIEW TECHNICAL SPEC</span>\n                <i class=\"ti ti-arrow-right\" data-kid=\"176\"></i>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"p-8 border border-[#2A3439]/10 bg-white relative overflow-hidden\" data-kid=\"177\">\n          <div class=\"relative z-10\" data-kid=\"178\">\n            <h4 class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-[#2A3439] mb-4\" data-kid=\"179\">Delta Subscription</h4>\n            <p class=\"text-xs text-[#2A3439]/60 mb-6 leading-relaxed\" data-kid=\"180\">Get automated diff reports when standards change in your configured jurisdictions.</p>\n            <button class=\"w-full bg-[#2A3439] text-white py-3 text-[10px] font-bold uppercase tracking-[0.25em