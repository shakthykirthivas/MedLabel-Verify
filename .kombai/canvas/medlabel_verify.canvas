      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Source+Serif+4:ital,opsz,wght@0,8..60,200..900;1,8..60,200..900&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --bg-parchment: #F4F0EC;\n    --text-onyx: #111111;\n    --brand-evergreen: #013220;\n    --border-hairline: rgba(17, 17, 17, 0.15);\n  }\n\n  body {\n    background-color: var(--bg-parchment);\n    color: var(--text-onyx);\n    font-family: 'Source Serif 4', serif;\n    margin: 0;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .font-serif-heading { font-family: 'Playfair Display', serif; }\n  .hairline-y { border-left: 1px solid var(--border-hairline); }\n  .hairline-x { border-top: 1px solid var(--border-hairline); }\n\n  /* Newspaper Masthead Pattern */\n  .masthead-rule {\n    height: 4px;\n    background: var(--text-onyx);\n    width: 100%;\n    margin-bottom: 2px;\n  }\n  .masthead-sub-rule {\n    height: 1px;\n    background: var(--text-onyx);\n    width: 100%;\n  }\n\n  .btn-evergreen {\n    background: var(--brand-evergreen);\n    color: white;\n    padding: 0.75rem 2rem;\n    font-weight: 500;\n    letter-spacing: 0.02em;\n    text-transform: uppercase;\n    font-size: 0.875rem;\n    transition: none; /* Driven by GSAP or static */\n  }\n\n  .btn-evergreen:hover {\n    background: #02452c;\n  }\n\n  /* Status Pills */\n  .status-pill {\n    padding: 2px 10px;\n    font-size: 11px;\n    text-transform: uppercase;\n    font-weight: 600;\n    letter-spacing: 0.05em;\n  }\n  .status-pill-success { background: #e6f2ed; color: #013220; border: 1px solid #013220; }\n</style>\n<link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"187\">\n\n<div id=\"smooth-wrapper\" data-kid=\"1\">\n  <div id=\"smooth-content\" data-kid=\"2\">\n    \n    \n    <header class=\"pt-8 pb-4 px-12\" data-kid=\"3\">\n      <div class=\"flex flex-col items-center\" data-kid=\"4\">\n        <div class=\"masthead-rule\" data-kid=\"5\"></div>\n        <div class=\"flex justify-between w-full py-4 items-center\" data-kid=\"6\">\n          <span class=\"text-xs uppercase tracking-widest font-semibold\" data-kid=\"7\">Volume IV · No. 22</span>\n          <div class=\"flex items-center gap-3 cursor-pointer\" data-kid=\"8\">\n            <span class=\"font-serif-heading text-4xl tracking-tighter font-black\" data-kid=\"9\">MEDLABEL VERIFY</span>\n          </div>\n          <span class=\"text-xs uppercase tracking-widest font-semibold\" data-kid=\"10\">London · New York · Tokyo</span>\n        </div>\n        <div class=\"masthead-sub-rule\" data-kid=\"11\"></div>\n      </div>\n      \n      <nav class=\"flex justify-center gap-12 py-6 text-sm uppercase tracking-widest font-medium\" data-kid=\"12\">\n        <a href=\"#\" class=\"hover:italic\" data-kid=\"13\">Verification</a>\n        <a href=\"#\" class=\"hover:italic\" data-kid=\"14\">Jurisdictions</a>\n        <a href=\"#\" class=\"hover:italic\" data-kid=\"15\">Institutional Standards</a>\n        <a href=\"#\" class=\"hover:italic\" data-kid=\"16\">Technical Papers</a>\n      </nav>\n      <div class=\"masthead-sub-rule\" data-kid=\"17\"></div>\n    </header>\n\n    \n    <section class=\"px-12 py-12\" data-kid=\"18\">\n      <div class=\"max-w-6xl mx-auto\" data-kid=\"19\">\n        <h1 class=\"font-serif-heading text-center text-7xl leading-[0.95] mb-16 max-w-4xl mx-auto opacity-0 reveal-y\" data-kid=\"20\">\n          The Global Standard in Medical Label Verification.\n        </h1>\n        \n        <div class=\"grid grid-cols-12 gap-12\" data-kid=\"21\">\n          \n          <div class=\"col-span-3 opacity-0 reveal-left\" data-kid=\"22\">\n            <h3 class=\"font-serif-heading text-xl italic mb-4\" data-kid=\"23\">Institutional Oversight</h3>\n            <p class=\"text-base leading-relaxed text-justify mb-6\" data-kid=\"24\">\n              In an era of intensifying regulatory scrutiny, MedLabel Verify provides the precise analytical framework required for absolute compliance. Our platform bridges the gap between complex jurisdictional mandates and production reality.\n            </p>\n            <div class=\"hairline-x pt-4\" data-kid=\"25\">\n              <span class=\"text-[10px] uppercase tracking-widest font-bold opacity-60\" data-kid=\"26\">Field Extractors</span>\n              <ul class=\"mt-2 space-y-1 text-sm italic\" data-kid=\"27\">\n                <li data-kid=\"28\">UDI-DI Compliance Check</li>\n                <li data-kid=\"29\">Sterilization Symbols</li>\n                <li data-kid=\"30\">Manufacturer Identification</li>\n              </ul>\n            </div>\n          </div>\n\n          \n          <div class=\"col-span-6 flex flex-col items-center opacity-0 reveal-blur\" data-kid=\"31\">\n            <img src=\"https://images.unsplash.com/photo-1562155695-fb6e1f95fcfd?auto=format&w=1200&q=80&fit=crop\" alt=\"High-resolution printing facility\" class=\"w-full grayscale border border-[var(--text-onyx)] mb-8\" decoding=\"async\" loading=\"lazy\" data-kid=\"32\">\n            <button class=\"btn-evergreen\" data-kid=\"33\">Initiate Institutional Audit</button>\n            <p class=\"mt-4 text-xs italic opacity-70\" data-kid=\"34\">Fig 1. Automated verification at a pharmaceutical packaging facility.</p>\n          </div>\n\n          \n          <div class=\"col-span-3 opacity-0 reveal-right\" data-kid=\"35\">\n            <h3 class=\"font-serif-heading text-xl italic mb-4\" data-kid=\"36\">Cross-Border Accuracy</h3>\n            <p class=\"text-base leading-relaxed text-justify mb-6\" data-kid=\"37\">\n              Verified against US FDA 21 CFR Part 801, EU MDR 2017/745, and Indian CDSCO Rules. We read what machines print, ensuring that no symbol is misplaced and no warning is omitted.\n            </p>\n            <div class=\"hairline-x pt-4\" data-kid=\"38\">\n              <span class=\"text-[10px] uppercase tracking-widest font-bold opacity-60\" data-kid=\"39\">Verified Assets</span>\n              <div class=\"flex flex-wrap gap-2 mt-3\" data-kid=\"40\">\n                <span class=\"px-2 py-1 bg-black/5 text-[10px] font-bold uppercase tracking-tighter\" data-kid=\"41\">Thermometer</span>\n                <span class=\"px-2 py-1 bg-black/5 text-[10px] font-bold uppercase tracking-tighter\" data-kid=\"42\">ECG Machine</span>\n                <span class=\"px-2 py-1 bg-black/5 text-[10px] font-bold uppercase tracking-tighter\" data-kid=\"43\">Syringe</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"px-12 py-24 bg-white/50 border-y border-[var(--border-hairline)]\" data-kid=\"44\">\n      <div class=\"max-w-6xl mx-auto grid grid-cols-2 gap-0\" data-kid=\"45\">\n        \n        <div class=\"pr-24 py-12\" data-kid=\"46\">\n          <span class=\"text-[10px] uppercase tracking-widest font-bold text-red-900 mb-6 block opacity-0 reveal-fade\" data-kid=\"47\">Risk Analysis</span>\n          <h2 class=\"font-serif-heading text-4xl mb-8 opacity-0 reveal-fade\" data-kid=\"48\">The Cost of Regulatory Friction</h2>\n          <ul class=\"space-y-6 opacity-0 reveal-fade\" data-kid=\"49\">\n            <li class=\"flex gap-4\" data-kid=\"50\">\n              <span class=\"font-serif-heading text-xl italic opacity-30\" data-kid=\"51\">01</span>\n              <p class=\"text-lg\" data-kid=\"52\">Product recalls exceeding $2.5M per incident due to missing UDI identifiers.</p>\n            </li>\n            <li class=\"flex gap-4\" data-kid=\"53\">\n              <span class=\"font-serif-heading text-xl italic opacity-30\" data-kid=\"54\">02</span>\n              <p class=\"text-lg\" data-kid=\"55\">Institutional fines and PMDA market delays from translation inaccuracies.</p>\n            </li>\n            <li class=\"flex gap-4\" data-kid=\"56\">\n              <span class=\"font-serif-heading text-xl italic opacity-30\" data-kid=\"57\">03</span>\n              <p class=\"text-lg\" data-kid=\"58\">Supply chain paralysis during manual label audits and verification cycles.</p>\n            </li>\n          </ul>\n        </div>\n        \n        \n        <div class=\"pl-24 py-12 hairline-y border-red-900/10\" data-kid=\"59\">\n          <span class=\"text-[10px] uppercase tracking-widest font-bold text-[var(--brand-evergreen)] mb-6 block opacity-0 reveal-fade\" data-kid=\"60\">Automated Assurance</span>\n          <h2 class=\"font-serif-heading text-4xl mb-8 opacity-0 reveal-fade\" data-kid=\"61\">MedLabel Verified Output</h2>\n          <ul class=\"space-y-6 opacity-0 reveal-fade\" data-kid=\"62\">\n            <li class=\"flex gap-4\" data-kid=\"63\">\n              <span class=\"font-serif-heading text-xl italic text-[var(--brand-evergreen)]\" data-kid=\"64\">01</span>\n              <p class=\"text-lg\" data-kid=\"65\">Instant jurisdictional scoring with 99.9% Optical Character Verification (OCV).</p>\n            </li>\n            <li class=\"flex gap-4\" data-kid=\"66\">\n              <span class=\"font-serif-heading text-xl italic text-[var(--brand-evergreen)]\" data-kid=\"67\">02</span>\n              <p class=\"text-lg\" data-kid=\"68\">Automated symbol validation against ISO 15223-1:2021 global standards.</p>\n            </li>\n            <li class=\"flex gap-4\" data-kid=\"69\">\n              <span class=\"font-serif-heading text-xl italic text-[var(--brand-evergreen)]\" data-kid=\"70\">03</span>\n              <p class=\"text-lg\" data-kid=\"71\">Production-ready compliance certificates generated in under 0.5 seconds.</p>\n            </li>\n          </ul>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"px-12 py-24\" data-kid=\"72\">\n      <div class=\"max-w-6xl mx-auto\" data-kid=\"73\">\n        <div class=\"grid grid-cols-12 gap-12 items-start\" data-kid=\"74\">\n          \n          <div class=\"col-span-8 opacity-0 reveal-y\" data-kid=\"75\">\n            <span class=\"text-xs uppercase tracking-[0.2em] font-bold mb-4 block\" data-kid=\"76\">Core Capability</span>\n            <h2 class=\"font-serif-heading text-6xl mb-12\" data-kid=\"77\">Neural-Driven Optical Verification</h2>\n            <div class=\"relative bg-[var(--text-onyx)] p-8 rounded-sm\" data-kid=\"78\">\n              <div class=\"flex justify-between items-center mb-6 text-white/50 text-[10px] uppercase tracking-widest border-b border-white/10 pb-4\" data-kid=\"79\">\n                <span data-kid=\"80\">Verification HUD v4.2</span>\n                <span class=\"flex items-center gap-2\" data-kid=\"81\"><i class=\"ti ti-scan\" data-kid=\"82\"></i> Scanning Live Feed...</span>\n              </div>\n              <div class=\"grid grid-cols-2 gap-8\" data-kid=\"83\">\n                <div class=\"space-y-4\" data-kid=\"84\">\n                  <div class=\"flex justify-between text-white/80 text-sm italic\" data-kid=\"85\">\n                    <span data-kid=\"86\">Field: Manufacturer</span>\n                    <span class=\"text-[var(--brand-evergreen)] font-bold\" data-kid=\"87\">MATCH</span>\n                  </div>\n                  <div class=\"h-0.5 bg-white/10 relative overflow-hidden\" data-kid=\"88\">\n                    <div class=\"absolute inset-0 bg-white/40 w-full animate-[pulse_2s_infinite]\" data-kid=\"89\"></div>\n                  </div>\n                  <div class=\"flex justify-between text-white/80 text-sm italic\" data-kid=\"90\">\n                    <span data-kid=\"91\">Field: Lot Number</span>\n                    <span class=\"text-[var(--brand-evergreen)] font-bold\" data-kid=\"92\">MATCH</span>\n                  </div>\n                  <div class=\"h-0.5 bg-white/10\" data-kid=\"93\"></div>\n                  <div class=\"flex justify-between text-white/80 text-sm italic\" data-kid=\"94\">\n                    <span data-kid=\"95\">Field: Warning Text</span>\n                    <span class=\"text-red-400 font-bold\" data-kid=\"96\">OMISSION DETECTED</span>\n                  </div>\n                  <div class=\"h-0.5 bg-white/10\" data-kid=\"97\"></div>\n                </div>\n                <div class=\"bg-white/5 p-4 border border-white/10 flex flex-col justify-center\" data-kid=\"98\">\n                  <span class=\"text-white/40 text-[10px] uppercase font-bold mb-2\" data-kid=\"99\">Confidence Score</span>\n                  <span class=\"text-white font-serif-heading text-5xl\" data-kid=\"100\">99.98<span class=\"text-2xl opacity-40\" data-kid=\"101\">%</span></span>\n                  <p class=\"text-white/40 text-[10px] mt-4 leading-tight italic\" data-kid=\"102\">Algorithm version: Institutional 2026.1</p>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          \n          <div class=\"col-span-4 mt-20 space-y-12\" data-kid=\"103\">\n            <div class=\"opacity-0 reveal-right\" data-kid=\"104\">\n              <h4 class=\"font-serif-heading text-xl italic mb-3 border-b border-[var(--border-hairline)] pb-2\" data-kid=\"105\">Barcode Grading</h4>\n              <p class=\"text-sm leading-relaxed opacity-80\" data-kid=\"106\">Full ISO/IEC 15415 grading for 2D Data Matrix codes. Verification of UDI-DI string syntax and application identifiers.</p>\n            </div>\n            <div class=\"opacity-0 reveal-right\" data-kid=\"107\">\n              <h4 class=\"font-serif-heading text-xl italic mb-3 border-b border-[var(--border-hairline)] pb-2\" data-kid=\"108\">Translation Integrity</h4>\n              <p class=\"text-sm leading-relaxed opacity-80\" data-kid=\"109\">Automated cross-check of localized warning labels against master English regulatory dossiers. Multi-language field mapping.</p>\n            </div>\n            <div class=\"opacity-0 reveal-right\" data-kid=\"110\">\n              <h4 class=\"font-serif-heading text-xl italic mb-3 border-b border-[var(--border-hairline)] pb-2\" data-kid=\"111\">Symbol Inventory</h4>\n              <p class=\"text-sm leading-relaxed opacity-80\" data-kid=\"112\">Recognition of ISO 7000, 15223-1, and custom manufacturer-specific iconography with semantic validation.</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"px-12 py-32 bg-[#EEEAE5]\" data-kid=\"113\">\n      <div class=\"max-w-6xl mx-auto grid grid-cols-12 gap-12\" data-kid=\"114\">\n        <div class=\"col-span-7 py-12 opacity-0 reveal-y\" data-kid=\"115\">\n          <span class=\"text-[10px] uppercase tracking-widest font-bold mb-8 block opacity-40\" data-kid=\"116\">Proof of Concept</span>\n          <h2 class=\"font-serif-heading text-5xl mb-12\" data-kid=\"117\">Institutional Validation at Scale.</h2>\n          <div class=\"space-y-8 text-lg leading-relaxed text-justify\" data-kid=\"118\">\n            <p data-kid=\"119\">\n              When a Tier-1 pharmaceutical manufacturer faced a multi-national recall risk due to ambiguous label translation in the Japanese market, MedLabel Verify was deployed as the primary audit engine. Within 24 hours, over 14,000 label SKUs were scanned and verified against PMDA mandates.\n            </p>\n            <p class=\"font-serif-heading italic text-2xl\" data-kid=\"120\">\n              \"The speed was secondary to the institutional rigor. We needed a system that understood the nuances of regulatory phrasing, not just OCR.\"\n            </p>\n          </div>\n        </div>\n        \n        \n        <div class=\"col-span-4 col-start-9 flex flex-col justify-center opacity-0 reveal-right\" data-kid=\"121\">\n          <div class=\"hairline-y pl-8 py-8 border-[var(--brand-evergreen)]/30\" data-kid=\"122\">\n            <img src=\"https://images.unsplash.com/photo-1758518729929-8210d3b0839e?auto=format&w=400&q=80&fit=crop\" alt=\"Quality Assurance Executive\" class=\"w-32 h-32 grayscale border border-black mb-6\" decoding=\"async\" loading=\"lazy\" data-kid=\"123\">\n            <h4 class=\"font-serif-heading text-xl font-bold\" data-kid=\"124\">Eleanor Vance</h4>\n            <p class=\"text-xs uppercase tracking-widest font-bold opacity-60 mt-1\" data-kid=\"125\">SVP Quality Assurance, Novartis AG</p>\n            <div class=\"mt-8 flex gap-2\" data-kid=\"126\">\n              <i class=\"ti ti-shield-check text-[var(--brand-evergreen)] text-2xl\" data-kid=\"127\"></i>\n              <span class=\"text-[10px] uppercase font-bold tracking-widest mt-1\" data-kid=\"128\">Verified Audit Partner</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section class=\"px-12 py-32\" data-kid=\"129\">\n      <div class=\"max-w-6xl mx-auto\" data-kid=\"130\">\n        <div class=\"text-center mb-16 opacity-0 reveal-y\" data-kid=\"131\">\n          <h2 class=\"font-serif-heading text-4xl mb-4\" data-kid=\"132\">Security & Regulatory Certifications</h2>\n          <p class=\"text-sm italic opacity-60\" data-kid=\"133\">MedLabel Verify operates under the strictest global institutional controls.</p>\n        </div>\n        \n        <table class=\"w-full border-collapse opacity-0 reveal-y\" data-kid=\"134\">\n          <thead data-kid=\"135\">\n            <tr class=\"text-[10px] uppercase tracking-widest font-bold opacity-40 border-b border-black text-left\" data-kid=\"136\">\n              <th class=\"py-4 px-6\" data-kid=\"137\">Certification Standard</th>\n              <th class=\"py-4 px-6\" data-kid=\"138\">Governing Body</th>\n              <th class=\"py-4 px-6\" data-kid=\"139\">Jurisdiction</th>\n              <th class=\"py-4 px-6 text-right\" data-kid=\"140\">Status</th>\n            </tr>\n          </thead>\n          <tbody class=\"text-sm\" data-kid=\"141\">\n            <tr class=\"border-b border-[var(--border-hairline)]\" data-kid=\"142\">\n              <td class=\"py-6 px-6 font-serif-heading text-lg\" data-kid=\"143\">ISO 27001:2022</td>\n              <td class=\"py-6 px-6 italic\" data-kid=\"144\">International Organization for Standardization</td>\n              <td class=\"py-6 px-6\" data-kid=\"145\">Global</td>\n              <td class=\"py-6 px-6 text-right\" data-kid=\"146\"><span class=\"status-pill status-pill-success\" data-kid=\"147\">Compliant</span></td>\n            </tr>\n            <tr class=\"border-b border-[var(--border-hairline)]\" data-kid=\"148\">\n              <td class=\"py-6 px-6 font-serif-heading text-lg\" data-kid=\"149\">FDA 21 CFR Part 11</td>\n              <td class=\"py-6 px-6 italic\" data-kid=\"150\">U.S. Food and Drug Administration</td>\n              <td class=\"py-6 px-6\" data-kid=\"151\">United States</td>\n              <td class=\"py-6 px-6 text-right\" data-kid=\"152\"><span class=\"status-pill status-pill-success\" data-kid=\"153\">Verified</span></td>\n            </tr>\n            <tr class=\"border-b border-[var(--border-hairline)]\" data-kid=\"154\">\n              <td class=\"py-6 px-6 font-serif-heading text-lg\" data-kid=\"155\">SOC 2 Type II</td>\n              <td class=\"py-6 px-6 italic\" data-kid=\"156\">AICPA</td>\n              <td class=\"py-6 px-6\" data-kid=\"157\">North America</td>\n              <td class=\"py-6 px-6 text-right\" data-kid=\"158\"><span class=\"status-pill status-pill-success\" data-kid=\"159\">Audited</span></td>\n            </tr>\n            <tr class=\"border-b border-[var(--border-hairline)]\" data-kid=\"160\">\n              <td class=\"py-6 px-6 font-serif-heading text-lg\" data-kid=\"161\">HIPAA Compliance</td>\n              <td class=\"py-6 px-6 italic\" data-kid=\"162\">U.S. Dept. of Health & Human Services</td>\n              <td class=\"py-6 px-6\" data-kid=\"163\">United States</td>\n              <td class=\"py-6 px-6 text-right\" data-kid=\"164\"><span class=\"status-pill status-pill-success\" data-kid=\"165\">Certified</span></td>\n            </tr>\n            <tr class=\"opacity-30\" data-kid=\"166\">\n              <td class=\"py-6 px-6 font-serif-heading text-lg italic\" data-kid=\"167\">ISO 13485:2016</td>\n              <td class=\"py-6 px-6 italic\" data-kid=\"168\">Medical Device Management</td>\n              <td class=\"py-6 px-6\" data-kid=\"169\">Global</td>\n              <td class=\"py-6 px-6 text-right\" data-kid=\"170\"><span class=\"status-pill status-pill-success opacity-50\" data-kid=\"171\">In Review</span></td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n    </section>\n\n    \n    <footer class=\"px-12 pt-12 pb-24 border-t-2 border-[var(--text-onyx)]\" data-kid=\"172\">\n      <div class=\"max-w-6xl mx-auto flex flex-col items-center\" data-kid=\"173\">\n        <div class=\"flex justify-between w-full items-baseline mb-12\" data-kid=\"174\">\n          <div class=\"flex items-center gap-4\" data-kid=\"175\">\n            <span class=\"font-serif-heading text-3xl font-black\" data-kid=\"176\">MLV</span>\n            <span class=\"text-[10px] uppercase tracking-[0.4em] font-bold\" data-kid=\"177\">Institutional Accuracy</span>\n          </div>\n          <nav class=\"flex gap-8 text-[10px] uppercase tracking-widest font-bold\" data-kid=\"178\">\n            <a href=\"#\" class=\"hover:underline\" data-kid=\"179\">Privacy Policy</a>\n            <a href=\"#\" class=\"hover:underline\" data-kid=\"180\">Institutional Terms</a>\n            <a href=\"#\" class=\"hover:underline\" data-kid=\"181\">Legal Disclosure</a>\n            <a href=\"#\" class=\"hover:underline\" data-kid=\"182\">Contact</a>\n          </nav>\n        </div>\n        <div class=\"w-full text-[10px] uppercase tracking-widest font-bold text-center opacity-40\" data-kid=\"183\">\n          © 2026 MedLabel Verify · An Institutional Compliance Authority · All Rights Reserved\n        </div>\n      </div>\n    </footer>\n\n  </div>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"184\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"185\"></script>\n<script type=\"module\" data-kid=\"186\">\n  import Lenis from \"https://esm.sh/lenis@1\"\n  \n  // Setup Lenis Smooth Scroll\n  const lenis = new Lenis({ autoRaf: true });\n  \n  // Register GSAP Plugins\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Entrance reveals\n  const revealElements = [\n    { selector: '.reveal-y', y: 40, autoAlpha: 0 },\n    { selector: '.reveal-left', x: -40, autoAlpha: 0 },\n    { selector: '.reveal-right', x: 40, autoAlpha: 0 },\n    { selector: '.reveal-blur', filter: 'blur(10px)', autoAlpha: 0 },\n    { selector: '.reveal-fade', autoAlpha: 0 }\n  ];\n\n  revealElements.forEach(config => {\n    gsap.utils.toArray(config.selector).forEach(el => {\n      gsap.to(el, {\n        scrollTrigger: {\n          trigger: el,\n          start: 'top 85%',\n          toggleActions: 'play none none none'\n        },\n        y: config.y || 0,\n        x: config.x || 0,\n        autoAlpha: 1,\n        filter: 'blur(0px)',\n        duration: 1,\n        ease: 'power3.out',\n        stagger: 0.1\n      });\n    });\n  });\n\n</script>",
      "comments": [],
