      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=IBM+Plex+Sans:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --color-bg: var(--k-color-bg-page);\n    --color-text: var(--k-color-text-primary);\n    --color-accent: var(--k-color-accent);\n    --color-border: var(--k-color-border);\n    --font-heading: var(--k-font-family-heading);\n    --font-body: var(--k-font-family-body);\n  }\n\n  body {\n    background-color: var(--color-bg);\n    color: var(--color-text);\n    font-family: var(--font-body);\n    -webkit-font-smoothing: antialiased;\n    overflow-x: clip;\n  }\n\n  .swiss-grid {\n    display: grid;\n    grid-template-columns: repeat(12, 1fr);\n    gap: 24px;\n    max-width: 1440px;\n    margin: 0 auto;\n    padding: 0 40px;\n  }\n\n  .hairline-rule {\n    height: 1px;\n    background-color: var(--color-text);\n    opacity: 0.1;\n  }\n\n  /* Custom selection */\n  ::selection {\n    background: var(--color-accent);\n    color: white;\n  }\n\n  /* Lenis support */\n  html.lenis {\n    height: auto;\n  }\n  .lenis-smooth {\n    scroll-behavior: auto !important;\n  }\n  .lenis-smooth [data-lenis-prevent] {\n    overscroll-behavior: contain;\n  }\n</style>\n\n<link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"1\">\n<div class=\"min-h-screen\" data-kid=\"2\">\n  \n  <nav class=\"sticky top-0 z-50 bg-white/95 backdrop-blur-xl border-b border-[var(--k-color-primary)]/10\" data-kid=\"3\">\n    <div class=\"swiss-grid py-5 items-center\" data-kid=\"4\">\n      <div class=\"col-span-3 flex items-center gap-3 group cursor-pointer\" data-kid=\"5\">\n        <div class=\"w-9 h-9 bg-[var(--k-color-primary)] flex items-center justify-center text-white font-bold text-lg\" data-kid=\"6\">M</div>\n        <span class=\"font-[var(--k-font-family-heading)] font-extrabold tracking-tighter text-xl uppercase\" data-kid=\"7\">MEDLABEL<span class=\"font-normal opacity-40\" data-kid=\"8\">VERIFY</span></span>\n      </div>\n      <div class=\"col-span-6 flex justify-center gap-10 font-bold text-xs tracking-widest uppercase\" data-kid=\"9\">\n        <a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"10\">Documentation</a>\n        <a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"11\">Audit Protocol</a>\n        <a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"12\">Developer Portal</a>\n        <a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-colors\" data-kid=\"13\">Company</a>\n      </div>\n      <div class=\"col-span-3 flex justify-end\" data-kid=\"14\">\n        <button class=\"bg-[var(--k-color-accent)] text-white px-7 py-3 font-bold text-xs tracking-widest uppercase hover:bg-black transition-all\" data-kid=\"15\">\n          Technical Audit\n        </button>\n      </div>\n    </div>\n  </nav>\n\n  \n  <header class=\"pt-24 pb-32 border-b border-[var(--k-color-primary)]/10\" id=\"hero\" data-kid=\"16\">\n    <div class=\"swiss-grid\" data-kid=\"17\">\n      <div class=\"col-span-1 font-mono text-sm opacity-20\" id=\"hero-index\" data-kid=\"18\">01</div>\n      <div class=\"col-span-9\" data-kid=\"19\">\n        <div class=\"mb-10 flex items-center gap-4 animate-fadeIn\" data-kid=\"20\">\n          <span class=\"px-2.5 py-1 border border-[var(--k-color-primary)] text-xs font-bold uppercase tracking-widest\" data-kid=\"21\">Support Portal</span>\n          <div class=\"w-2 h-2 rounded-full bg-green-500\" data-kid=\"22\"></div>\n          <span class=\"text-xs font-bold uppercase tracking-widest opacity-40\" data-kid=\"23\">System Status: Operational</span>\n        </div>\n        <h1 class=\"text-[84px] leading-[0.9] font-extrabold tracking-tighter mb-16 text-[var(--k-color-primary)]\" id=\"hero-title\" data-kid=\"24\">\n          Knowledge Access <br data-kid=\"25\"> & Technical Support.\n        </h1>\n        \n        <div class=\"relative max-w-2xl group\" id=\"search-container\" data-kid=\"26\">\n          <input type=\"text\" placeholder=\"Search documentation, compliance rules, or technical specs...\" class=\"w-full bg-transparent border-b-2 border-[var(--k-color-primary)] py-8 text-2xl font-light focus:outline-hidden focus:border-[var(--k-color-accent)] transition-all placeholder:text-[var(--k-color-primary)]/20\" data-kid=\"27\">\n          <div class=\"absolute right-0 top-1/2 -translate-y-1/2 cursor-pointer group-hover:scale-110 transition-transform\" data-kid=\"28\">\n              <i class=\"ti ti-search text-3xl text-[var(--k-color-primary)]\" data-kid=\"29\"></i>\n          </div>\n          <div class=\"flex gap-8 mt-8\" data-kid=\"30\">\n            <span class=\"text-xs font-bold uppercase tracking-widest opacity-30\" data-kid=\"31\">Quick Access:</span>\n            <a href=\"#\" class=\"text-xs font-bold uppercase tracking-widest hover:text-[var(--k-color-accent)] border-b border-transparent hover:border-[var(--k-color-accent)]\" data-kid=\"32\">FDA 21 CFR</a>\n            <a href=\"#\" class=\"text-xs font-bold uppercase tracking-widest hover:text-[var(--k-color-accent)] border-b border-transparent hover:border-[var(--k-color-accent)]\" data-kid=\"33\">API Integration</a>\n            <a href=\"#\" class=\"text-xs font-bold uppercase tracking-widest hover:text-[var(--k-color-accent)] border-b border-transparent hover:border-[var(--k-color-accent)]\" data-kid=\"34\">Audit Trails</a>\n          </div>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  \n  <section class=\"py-32\" id=\"categories\" data-kid=\"35\">\n    <div class=\"swiss-grid mb-12 items-end\" data-kid=\"36\">\n        <div class=\"col-span-1 font-mono text-sm opacity-20\" data-kid=\"37\">02</div>\n        <div class=\"col-span-11 flex justify-between items-end\" data-kid=\"38\">\n            <h2 class=\"text-xs font-bold uppercase tracking-[0.4em] opacity-40\" data-kid=\"39\">Knowledge Architecture</h2>\n            <span class=\"text-xs font-mono opacity-30\" data-kid=\"40\">REF: DOC_SYSTEM_v4.2</span>\n        </div>\n    </div>\n    \n    <div class=\"swiss-grid border-y border-[var(--k-color-primary)]\" data-kid=\"41\">\n      <div class=\"col-span-12\" data-kid=\"42\">\n        \n        <div class=\"grid grid-cols-12 items-center py-12 border-b border-[var(--k-color-primary)]/10 hover:bg-[var(--k-color-bg-surface)] group cursor-pointer capability-card transition-colors\" data-kid=\"43\">\n          <div class=\"col-span-1 font-mono text-sm pl-4\" data-kid=\"44\">01</div>\n          <div class=\"col-span-3\" data-kid=\"45\">\n            <span class=\"text-xs font-mono opacity-30 uppercase block mb-1\" data-kid=\"46\">Module ID</span>\n            <span class=\"text-xl font-extrabold uppercase tracking-tight\" data-kid=\"47\">Integration</span>\n          </div>\n          <div class=\"col-span-5 pr-10\" data-kid=\"48\">\n            <span class=\"text-xs font-mono opacity-30 uppercase block mb-1\" data-kid=\"49\">Description</span>\n            <p class=\"text-sm text-[var(--k-color-text-muted)] leading-relaxed\" data-kid=\"50\">Technical frameworks for REST API endpoints, secure webhooks, and enterprise ERP synchronization via cryptographically signed protocols.</p>\n          </div>\n          <div class=\"col-span-2\" data-kid=\"51\">\n            <div class=\"flex flex-wrap gap-2\" data-kid=\"52\">\n              <span class=\"text-[10px] px-2 py-0.5 border border-[var(--k-color-primary)]/10 font-bold uppercase tracking-widest\" data-kid=\"53\">JSON</span>\n              <span class=\"text-[10px] px-2 py-0.5 border border-[var(--k-color-primary)]/10 font-bold uppercase tracking-widest\" data-kid=\"54\">OAUTH 2.0</span>\n            </div>\n          </div>\n          <div class=\"col-span-1 flex justify-end pr-4\" data-kid=\"55\">\n            <div class=\"w-10 h-10 border border-[var(--k-color-primary)]/10 flex items-center justify-center group-hover:bg-[var(--k-color-primary)] group-hover:text-white transition-colors\" data-kid=\"56\">\n              <i class=\"ti ti-arrow-right text-xl\" data-kid=\"57\"></i>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"grid grid-cols-12 items-center py-12 border-b border-[var(--k-color-primary)]/10 hover:bg-[var(--k-color-bg-surface)] group cursor-pointer capability-card transition-colors\" data-kid=\"58\">\n          <div class=\"col-span-1 font-mono text-sm pl-4\" data-kid=\"59\">02</div>\n          <div class=\"col-span-3\" data-kid=\"60\">\n            <span class=\"text-xs font-mono opacity-30 uppercase block mb-1\" data-kid=\"61\">Module ID</span>\n            <span class=\"text-xl font-extrabold uppercase tracking-tight\" data-kid=\"62\">Compliance FAQ</span>\n          </div>\n          <div class=\"col-span-5 pr-10\" data-kid=\"63\">\n            <span class=\"text-xs font-mono opacity-30 uppercase block mb-1\" data-kid=\"64\">Description</span>\n            <p class=\"text-sm text-[var(--k-color-text-muted)] leading-relaxed\" data-kid=\"65\">Regulatory alignment matrices for FDA, MHRA, and Global UDI standards. Comprehensive analysis of deterministic logic application.</p>\n          </div>\n          <div class=\"col-span-2\" data-kid=\"66\">\n            <div class=\"flex flex-wrap gap-2\" data-kid=\"67\">\n              <span class=\"text-[10px] px-2 py-0.5 border border-[var(--k-color-primary)]/10 font-bold uppercase tracking-widest\" data-kid=\"68\">FDA</span>\n              <span class=\"text-[10px] px-2 py-0.5 border border-[var(--k-color-primary)]/10 font-bold uppercase tracking-widest\" data-kid=\"69\">ISO 15416</span>\n            </div>\n          </div>\n          <div class=\"col-span-1 flex justify-end pr-4\" data-kid=\"70\">\n            <div class=\"w-10 h-10 border border-[var(--k-color-primary)]/10 flex items-center justify-center group-hover:bg-[var(--k-color-primary)] group-hover:text-white transition-colors\" data-kid=\"71\">\n              <i class=\"ti ti-arrow-right text-xl\" data-kid=\"72\"></i>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"grid grid-cols-12 items-center py-12 hover:bg-[var(--k-color-bg-surface)] group cursor-pointer capability-card transition-colors\" data-kid=\"73\">\n          <div class=\"col-span-1 font-mono text-sm pl-4\" data-kid=\"74\">03</div>\n          <div class=\"col-span-3\" data-kid=\"75\">\n            <span class=\"text-xs font-mono opacity-30 uppercase block mb-1\" data-kid=\"76\">Module ID</span>\n            <span class=\"text-xl font-extrabold uppercase tracking-tight\" data-kid=\"77\">Account</span>\n          </div>\n          <div class=\"col-span-5 pr-10\" data-kid=\"78\">\n            <span class=\"text-xs font-mono opacity-30 uppercase block mb-1\" data-kid=\"79\">Description</span>\n            <p class=\"text-sm text-[var(--k-color-text-muted)] leading-relaxed\" data-kid=\"80\">Institutional protocols for administrative permissions, cryptographic audit logs, and SOC2 compliant security infrastructure management.</p>\n          </div>\n          <div class=\"col-span-2\" data-kid=\"81\">\n            <div class=\"flex flex-wrap gap-2\" data-kid=\"82\">\n              <span class=\"text-[10px] px-2 py-0.5 border border-[var(--k-color-primary)]/10 font-bold uppercase tracking-widest\" data-kid=\"83\">SSO</span>\n              <span class=\"text-[10px] px-2 py-0.5 border border-[var(--k-color-primary)]/10 font-bold uppercase tracking-widest\" data-kid=\"84\">AUDIT</span>\n            </div>\n          </div>\n          <div class=\"col-span-1 flex justify-end pr-4\" data-kid=\"85\">\n            <div class=\"w-10 h-10 border border-[var(--k-color-primary)]/10 flex items-center justify-center group-hover:bg-[var(--k-color-primary)] group-hover:text-white transition-colors\" data-kid=\"86\">\n              <i class=\"ti ti-arrow-right text-xl\" data-kid=\"87\"></i>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 bg-[var(--k-color-bg-surface)]/50 border-b border-[var(--k-color-primary)]/10\" id=\"article\" data-kid=\"88\">\n    <div class=\"swiss-grid\" data-kid=\"89\">\n      <div class=\"col-span-1 font-mono text-sm opacity-20\" data-kid=\"90\">03</div>\n      <div class=\"col-span-11\" data-kid=\"91\">\n        <div class=\"grid grid-cols-11 gap-12\" data-kid=\"92\">\n          \n          <article class=\"col-span-7 pr-12\" data-kid=\"93\">\n            <div class=\"flex items-center gap-4 mb-12\" data-kid=\"94\">\n                <a href=\"#\" class=\"text-xs font-bold uppercase tracking-widest text-[var(--k-color-accent)] border-b border-[var(--k-color-accent)]\" data-kid=\"95\">Documentation</a>\n                <span class=\"opacity-20\" data-kid=\"96\">/</span>\n                <span class=\"text-xs font-bold uppercase tracking-widest opacity-40\" data-kid=\"97\">Compliance Standards</span>\n            </div>\n            \n            <h2 class=\"text-6xl font-extrabold tracking-tighter mb-12 leading-tight text-[var(--k-color-primary)]\" data-kid=\"98\">\n                Implementing 21 CFR Part 801 <br data-kid=\"99\"> Labeling Requirements\n            </h2>\n            \n            <div class=\"flex items-center gap-8 mb-16 pb-12 border-b border-[var(--k-color-primary)]/10\" data-kid=\"100\">\n                <div class=\"flex items-center gap-3\" data-kid=\"101\">\n                    <div class=\"w-11 h-11 bg-[var(--k-color-primary)] text-white flex items-center justify-center font-bold text-xs uppercase\" data-kid=\"102\">AT</div>\n                    <div data-kid=\"103\">\n                      <div class=\"text-xs font-bold uppercase tracking-widest\" data-kid=\"104\">Audit Team</div>\n                      <div class=\"text-xs font-mono opacity-40 uppercase\" data-kid=\"105\">Certified Compliance Officers</div>\n                    </div>\n                </div>\n                <div class=\"h-10 w-[1px] bg-[var(--k-color-primary)]/10\" data-kid=\"106\"></div>\n                <div class=\"flex flex-col\" data-kid=\"107\">\n                  <span class=\"text-xs font-mono opacity-40 uppercase\" data-kid=\"108\">Doc ID</span>\n                  <span class=\"text-xs font-bold uppercase tracking-widest\" data-kid=\"109\">MLV-CS-801</span>\n                </div>\n                <div class=\"flex flex-col\" data-kid=\"110\">\n                  <span class=\"text-xs font-mono opacity-40 uppercase\" data-kid=\"111\">Last Verification</span>\n                  <span class=\"text-xs font-bold uppercase tracking-widest text-green-600\" data-kid=\"112\">June 13, 2026</span>\n                </div>\n            </div>\n\n            <div class=\"prose prose-slate max-w-none\" data-kid=\"113\">\n                <p class=\"text-xl text-[var(--k-color-primary)]/80 leading-relaxed font-light mb-12\" data-kid=\"114\">\n                    The Food and Drug Administration (FDA) mandates that all medical devices distributed within the United States adhere to 21 CFR Part 801. Our verification engine implements deterministic rulesets to ensure every scan meets these rigorous institutional standards.\n                </p>\n                \n                <h3 class=\"text-2xl font-bold tracking-tight mb-8\" data-kid=\"115\">Verification Logic Matrix</h3>\n                <div class=\"overflow-x-clip mb-16 border border-[var(--k-color-primary)]\" data-kid=\"116\">\n                    <table class=\"w-full border-collapse\" data-kid=\"117\">\n                        <thead data-kid=\"118\">\n                            <tr class=\"bg-[var(--k-color-primary)] text-white text-xs font-bold uppercase tracking-[0.2em]\" data-kid=\"119\">\n                                <th class=\"p-5 text-left border-r border-white/10\" data-kid=\"120\">Requirement ID</th>\n                                <th class=\"p-5 text-left border-r border-white/10\" data-kid=\"121\">Regulatory Clause</th>\n                                <th class=\"p-5 text-left\" data-kid=\"122\">Deterministic Rule</th>\n                            </tr>\n                        </thead>\n                        <tbody class=\"text-sm\" data-kid=\"123\">\n                            <tr class=\"border-b border-[var(--k-color-primary)]/10 hover:bg-[var(--k-color-accent)]/5\" data-kid=\"124\">\n                                <td class=\"p-5 font-mono text-xs border-r border-[var(--k-color-primary)]/10\" data-kid=\"125\">801.1</td>\n                                <td class=\"p-5 font-bold uppercase text-xs tracking-widest border-r border-[var(--k-color-primary)]/10\" data-kid=\"126\">Manufacturer ID</td>\n                                <td class=\"p-5 text-[var(--k-color-primary)]/70\" data-kid=\"127\">Cross-reference OCR-extracted address against GUDID database with 99.9% fuzzy match threshold.</td>\n                            </tr>\n                            <tr class=\"border-b border-[var(--k-color-primary)]/10 hover:bg-[var(--k-color-accent)]/5\" data-kid=\"128\">\n                                <td class=\"p-5 font-mono text-xs border-r border-[var(--k-color-primary)]/10\" data-kid=\"129\">801.15</td>\n                                <td class=\"p-5 font-bold uppercase text-xs tracking-widest border-r border-[var(--k-color-primary)]/10\" data-kid=\"130\">Typography Check</td>\n                                <td class=\"p-5 text-[var(--k-color-primary)]/70\" data-kid=\"131\">Geometric analysis of font height. Minimum 1/16 inch required for critical warning text blocks.</td>\n                            </tr>\n                            <tr class=\"hover:bg-[var(--k-color-accent)]/5\" data-kid=\"132\">\n                                <td class=\"p-5 font-mono text-xs border-r border-[var(--k-color-primary)]/10\" data-kid=\"133\">801.20</td>\n                                <td class=\"p-5 font-bold uppercase text-xs tracking-widest border-r border-[var(--k-color-primary)]/10\" data-kid=\"134\">UDI Format</td>\n                                <td class=\"p-5 text-[var(--k-color-primary)]/70\" data-kid=\"135\">Validation of GS1 or HIBCC data structure within the machine-readable component.</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n\n                <div class=\"p-12 border border-[var(--k-color-primary)] bg-white relative overflow-hidden group mb-16\" data-kid=\"136\">\n                    <div class=\"absolute top-0 right-0 p-4 opacity-5 pointer-events-none\" data-kid=\"137\">\n                      <div class=\"w-32 h-32 border-2 border-[var(--k-color-primary)] rotate-45 transform translate-x-12 -translate-y-12\" data-kid=\"138\"></div>\n                    </div>\n                    <h4 class=\"text-xs font-bold uppercase tracking-[0.3em] mb-6 text-[var(--k-color-accent)]\" data-kid=\"139\">Implementation Strategy</h4>\n                    <p class=\"text-base text-[var(--k-color-primary)]/70 leading-relaxed mb-8\" data-kid=\"140\">\n                        To successfully integrate these standards, manufacturers must ensure high-contrast printing (Grade A per ISO 15416) and utilize our 'Pre-Flight' API endpoint to validate label design mockups before physical production begins.\n                    </p>\n                    <button class=\"flex items-center gap-3 text-xs font-bold uppercase tracking-[0.2em] group cursor-pointer\" data-kid=\"141\">\n                      <span class=\"border-b-2 border-[var(--k-color-primary)] pb-1 group-hover:text-[var(--k-color-accent)] group-hover:border-[var(--k-color-accent)] transition-all\" data-kid=\"142\">View API Documentation</span>\n                      <i class=\"ti ti-arrow-right text-lg\" data-kid=\"143\"></i>\n                    </button>\n                </div>\n            </div>\n          </article>\n\n          \n          <aside class=\"col-span-4 border-l border-[var(--k-color-primary)]/10 pl-12 relative\" data-kid=\"144\">\n            <div class=\"sticky top-32\" data-kid=\"145\">\n                <h4 class=\"text-xs font-bold uppercase tracking-[0.3em] mb-10 opacity-30\" data-kid=\"146\">In this article</h4>\n                <nav class=\"flex flex-col gap-2\" id=\"article-nav\" data-kid=\"147\">\n                    <a href=\"#\" class=\"flex items-center justify-between group py-3 text-xs font-bold uppercase tracking-widest border-b border-[var(--k-color-primary)]/5 text-[var(--k-color-accent)]\" data-kid=\"148\">\n                      <span data-kid=\"149\">01 Overview</span>\n                      <div class=\"w-1.5 h-1.5 bg-[var(--k-color-accent)] rounded-full\" data-kid=\"150\"></div>\n                    </a>\n                    <a href=\"#\" class=\"flex items-center justify-between group py-3 text-xs font-bold uppercase tracking-widest border-b border-[var(--k-color-primary)]/5 opacity-40 hover:opacity-100 transition-all\" data-kid=\"151\">\n                      <span data-kid=\"152\">02 Logic Matrix</span>\n                      <i class=\"ti ti-chevron-right opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"153\"></i>\n                    </a>\n                    <a href=\"#\" class=\"flex items-center justify-between group py-3 text-xs font-bold uppercase tracking-widest border-b border-[var(--k-color-primary)]/5 opacity-40 hover:opacity-100 transition-all\" data-kid=\"154\">\n                      <span data-kid=\"155\">03 Typography Rules</span>\n                      <i class=\"ti ti-chevron-right opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"156\"></i>\n                    </a>\n                    <a href=\"#\" class=\"flex items-center justify-between group py-3 text-xs font-bold uppercase tracking-widest border-b border-[var(--k-color-primary)]/5 opacity-40 hover:opacity-100 transition-all\" data-kid=\"157\">\n                      <span data-kid=\"158\">04 UDI Standards</span>\n                      <i class=\"ti ti-chevron-right opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"159\"></i>\n                    </a>\n                    <a href=\"#\" class=\"flex items-center justify-between group py-3 text-xs font-bold uppercase tracking-widest opacity-40 hover:opacity-100 transition-all\" data-kid=\"160\">\n                      <span data-kid=\"161\">05 Global Exemptions</span>\n                      <i class=\"ti ti-chevron-right opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"162\"></i>\n                    </a>\n                </nav>\n                \n                <div class=\"mt-20 p-8 border border-[var(--k-color-primary)] bg-white shadow-xs relative overflow-hidden\" data-kid=\"163\">\n                    <div class=\"absolute top-0 right-0 w-8 h-8 opacity-10 pointer-events-none\" data-kid=\"164\">\n                      <div class=\"absolute top-0 right-0 w-full h-[1px] bg-[var(--k-color-primary)]\" data-kid=\"165\"></div>\n                      <div class=\"absolute top-0 right-0 h-full w-[1px] bg-[var(--k-color-primary)]\" data-kid=\"166\"></div>\n                    </div>\n                    <div class=\"mb-5 flex items-center justify-between\" data-kid=\"167\">\n                      <div class=\"flex items-center gap-2\" data-kid=\"168\">\n                        <span class=\"w-1.5 h-1.5 bg-red-500 rounded-full animate-pulse\" data-kid=\"169\"></span>\n                        <span class=\"text-xs font-mono font-bold uppercase tracking-widest opacity-40\" data-kid=\"170\">Notice</span>\n                      </div>\n                      <span class=\"text-[10px] font-mono opacity-30 uppercase tracking-tighter\" data-kid=\"171\">REF: SEC-99</span>\n                    </div>\n                    <h5 class=\"text-xs font-bold uppercase tracking-widest mb-3\" data-kid=\"172\">Precision Audit Required?</h5>\n                    <p class=\"text-xs text-[var(--k-color-primary)]/60 leading-relaxed mb-6\" data-kid=\"173\">\n                        Technical sessions available for regulatory transitions and high-volume platform scaling.\n                    </p>\n                    <button class=\"w-full py-4 bg-[var(--k-color-primary)] text-white text-xs font-bold uppercase tracking-widest hover:bg-black transition-all\" data-kid=\"174\">\n                        Request Technical Audit\n                    </button>\n                </div>\n\n                <div class=\"mt-8 flex items-center gap-4 p-5 bg-[var(--k-color-primary)]/5 border border-[var(--k-color-primary)]/5\" data-kid=\"175\">\n                  <i class=\"ti ti-file-download text-xl opacity-40\" data-kid=\"176\"></i>\n                  <div class=\"flex flex-col\" data-kid=\"177\">\n                    <span class=\"text-xs font-bold uppercase tracking-widest\" data-kid=\"178\">Download PDF Guide</span>\n                    <span class=\"text-[10px] font-mono opacity-30 uppercase\" data-kid=\"179\">Size: 4.2 MB &middot; Version: 2024.1</span>\n                  </div>\n                </div>\n            </div>\n          </aside>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 bg-[var(--k-color-primary)] text-white overflow-hidden relative\" id=\"contact\" data-kid=\"180\">\n    <div class=\"absolute inset-0 opacity-5 pointer-events-none\" style=\"background-image: radial-gradient(white 1px, transparent 1px); background-size: 30px 30px;\" data-kid=\"181\"></div>\n    <div class=\"swiss-grid relative z-10\" data-kid=\"182\">\n      <div class=\"col-span-1 font-mono text-sm opacity-20\" data-kid=\"183\">04</div>\n      <div class=\"col-span-7\" data-kid=\"184\">\n        <h2 class=\"text-7xl font-extrabold tracking-tighter mb-8 leading-none\" data-kid=\"185\">Connect with our <br data-kid=\"186\"> Technical Audit Team</h2>\n        <p class=\"text-xl font-light text-white/60 mb-12 max-w-2xl\" data-kid=\"187\">Institutional support for medical device manufacturers navigating the complexity of global regulatory frameworks. Guaranteed 12-hour response latency.</p>\n        <div class=\"flex items-center gap-10\" data-kid=\"188\">\n          <button class=\"bg-white text-[var(--k-color-primary)] px-12 py-6 font-extrabold text-xs uppercase tracking-widest hover:bg-[var(--k-color-accent)] hover:text-white transition-all\" data-kid=\"189\">Schedule Consultation</button>\n          <div class=\"flex flex-col\" data-kid=\"190\">\n            <span class=\"text-[10px] font-bold uppercase tracking-widest opacity-40\" data-kid=\"191\">Direct Line</span>\n            <span class=\"text-lg font-mono\" data-kid=\"192\">+41 44 201 0000</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"bg-white border-t-2 border-[var(--k-color-primary)] pt-24 pb-12\" data-kid=\"193\">\n    <div class=\"swiss-grid pb-24 border-b border-[var(--k-color-primary)]/10\" data-kid=\"194\">\n      <div class=\"col-span-4\" data-kid=\"195\">\n        <div class=\"flex items-center gap-2 mb-10 group cursor-pointer\" data-kid=\"196\">\n          <div class=\"w-10 h-10 bg-[var(--k-color-primary)] flex items-center justify-center text-white font-bold text-xl\" data-kid=\"197\">M</div>\n          <span class=\"font-[var(--k-font-family-heading)] font-extrabold tracking-tighter text-2xl uppercase text-[var(--k-color-primary)]\" data-kid=\"198\">MEDLABEL<span class=\"font-normal opacity-40\" data-kid=\"199\">VERIFY</span></span>\n        </div>\n        <p class=\"text-sm text-[var(--k-color-primary)]/60 leading-relaxed max-w-xs mb-10 font-medium\" data-kid=\"200\">\n          The institutional standard for medical device label verification and regulatory automation. Headquartered in Zurich.\n        </p>\n        <div class=\"flex gap-4\" data-kid=\"201\">\n          <a href=\"#\" class=\"w-12 h-12 border border-[var(--k-color-primary)]/20 flex items-center justify-center hover:bg-[var(--k-color-primary)] hover:text-white transition-all\" data-kid=\"202\"><i class=\"ti ti-brand-linkedin text-xl\" data-kid=\"203\"></i></a>\n          <a href=\"#\" class=\"w-12 h-12 border border-[var(--k-color-primary)]/20 flex items-center justify-center hover:bg-[var(--k-color-primary)] hover:text-white transition-all\" data-kid=\"204\"><i class=\"ti ti-brand-x text-xl\" data-kid=\"205\"></i></a>\n          <a href=\"#\" class=\"w-12 h-12 border border-[var(--k-color-primary)]/20 flex items-center justify-center hover:bg-[var(--k-color-primary)] hover:text-white transition-all\" data-kid=\"206\"><i class=\"ti ti-brand-github text-xl\" data-kid=\"207\"></i></a>\n        </div>\n      </div>\n      \n      <div class=\"col-span-2\" data-kid=\"208\">\n        <h4 class=\"text-xs font-bold uppercase tracking-widest mb-10 opacity-30\" data-kid=\"209\">Resources</h4>\n        <ul class=\"space-y-4 text-xs font-bold uppercase tracking-widest text-[var(--k-color-primary)]/60\" data-kid=\"210\">\n          <li data-kid=\"211\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-all hover:pl-1\" data-kid=\"212\">Doc Center</a></li>\n          <li data-kid=\"213\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-all hover:pl-1\" data-kid=\"214\">API Specs</a></li>\n          <li data-kid=\"215\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-all hover:pl-1\" data-kid=\"216\">SDKs</a></li>\n          <li data-kid=\"217\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-all hover:pl-1\" data-kid=\"218\">Security</a></li>\n        </ul>\n      </div>\n\n      <div class=\"col-span-2\" data-kid=\"219\">\n        <h4 class=\"text-xs font-bold uppercase tracking-widest mb-10 opacity-30\" data-kid=\"220\">Regulatory</h4>\n        <ul class=\"space-y-4 text-xs font-bold uppercase tracking-widest text-[var(--k-color-primary)]/60\" data-kid=\"221\">\n          <li data-kid=\"222\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-all hover:pl-1\" data-kid=\"223\">FDA (US)</a></li>\n          <li data-kid=\"224\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-all hover:pl-1\" data-kid=\"225\">MHRA (UK)</a></li>\n          <li data-kid=\"226\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-all hover:pl-1\" data-kid=\"227\">CDSCO (IN)</a></li>\n          <li data-kid=\"228\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-all hover:pl-1\" data-kid=\"229\">PMDA (JP)</a></li>\n        </ul>\n      </div>\n\n      <div class=\"col-span-2\" data-kid=\"230\">\n        <h4 class=\"text-xs font-bold uppercase tracking-widest mb-10 opacity-30\" data-kid=\"231\">Support</h4>\n        <ul class=\"space-y-4 text-xs font-bold uppercase tracking-widest text-[var(--k-color-primary)]/60\" data-kid=\"232\">\n          <li data-kid=\"233\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-all hover:pl-1\" data-kid=\"234\">Technical Audit</a></li>\n          <li data-kid=\"235\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-all hover:pl-1\" data-kid=\"236\">System Status</a></li>\n          <li data-kid=\"237\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-all hover:pl-1\" data-kid=\"238\">Training</a></li>\n          <li data-kid=\"239\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-all hover:pl-1\" data-kid=\"240\">Help Desk</a></li>\n        </ul>\n      </div>\n\n      <div class=\"col-span-2\" data-kid=\"241\">\n        <h4 class=\"text-xs font-bold uppercase tracking-widest mb-10 opacity-30\" data-kid=\"242\">Legal</h4>\n        <ul class=\"space-y-4 text-xs font-bold uppercase tracking-widest text-[var(--k-color-primary)]/60\" data-kid=\"243\">\n          <li data-kid=\"244\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-all hover:pl-1\" data-kid=\"245\">Privacy</a></li>\n          <li data-kid=\"246\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-all hover:pl-1\" data-kid=\"247\">Terms</a></li>\n          <li data-kid=\"248\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-all hover:pl-1\" data-kid=\"249\">Audit Rights</a></li>\n          <li data-kid=\"250\"><a href=\"#\" class=\"hover:text-[var(--k-color-accent)] transition-all hover:pl-1\" data-kid=\"251\">SLA</a></li>\n        </ul>\n      </div>\n    </div>\n    \n    <div class=\"swiss-grid pt-12\" data-kid=\"252\">\n      <div class=\"col-span-6 text-xs font-bold uppercase tracking-[0.3em] opacity-40\" data-kid=\"253\">\n        &copy; 2026 MedLabel Verify INC. Precision Compliance. 47.3769&deg; N, 8.5417&deg; E\n      </div>\n      <div class=\"col-span-6 text-right text-xs font-bold uppercase tracking-[0.3em] opacity-40\" data-kid=\"254\">\n        ISO 27001 Certified &middot; HIPAA Compliant &middot; GDPR Aligned\n      </div>\n    </div>\n  </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"255\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"256\"></script>\n<script type=\"module\" data-kid=\"257\">\n  import Lenis from \"https://esm.sh/lenis@1\"\n  import Snap from \"https://esm.sh/lenis@1/snap\"\n  \n  gsap.registerPlugin(ScrollTrigger);\n\n  // Initialize Lenis\n  const lenis = new Lenis({\n    duration: 1.2,\n    easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),\n    orientation: 'vertical',\n    gestureOrientation: 'vertical',\n    smoothWheel: true,\n  });\n\n  function raf(time) {\n    lenis.raf(time);\n    requestAnimationFrame(raf);\n  }\n  requestAnimationFrame(raf);\n\n  // Entrance Animations\n  const tl = gsap.timeline();\n  \n  tl.from('#hero-index', { opacity: 0, y: 20, duration: 1, ease: \"power4.out\" })\n    .from('#hero-title', { opacity: 0, y: 40, duration: 1, ease: \"power4.out\" }, \"-=0.8\")\n    .from('#search-container', { opacity: 0, y: 30, duration: 1, ease: \"power4.out\" }, \"-=0.6\");\n\n  // Category Cards Stagger\n  gsap.from('.capability-card', {\n    scrollTrigger: {\n      trigger: '#categories',\n      start: \"top 70%\",\n    },\n    opacity: 0,\n    y: 40,\n    stagger: 0.15,\n    duration: 1,\n    ease: \"power3.out\"\n  });\n\n  // Table rows slide in\n  gsap.from('tbody tr', {\n    scrollTrigger: {\n      trigger: 'table',\n      start: \"top 80%\",\n    },\n    opacity: 0,\n    x: -20,\n    stagger: 0.1,\n    duration: 0.8,\n    ease: \"power2.out\"\n  });\n\n  // Article Nav active state simulation (simple version)\n  const navLinks = document.querySelectorAll('#article-nav a');\n  navLinks.forEach(link => {\n    link.addEventListener('click', (e) => {\n      e.preventDefault();\n      navLinks.forEach(l => {\n        l.classList.add('opacity-40');\n        l.querySelector('div, i')?.classList.add('opacity-0');\n        l.classList.remove('text-[var(--k-color-accent)]');\n      });\n      link.classList.remove('opacity-40');\n      link.classList.add('text-[var(--k-color-accent)]');\n      link.querySelector('div, i')?.classList.remove('opacity-0');\n    });\n  });\n\n</script>\n",
