      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --color-bg: #FFFFFF;\n    --color-text: #2A3439;\n    --color-accent: #00356B;\n    --color-border: #E2E8F0;\n    --font-heading: 'Plus Jakarta Sans', sans-serif;\n    --font-body: 'IBM Plex Sans', sans-serif;\n  }\n\n  body {\n    margin: 0;\n    padding: 0;\n    background-color: var(--color-bg);\n    color: var(--color-text);\n    font-family: var(--font-body);\n    -webkit-font-smoothing: antialiased;\n  }\n\n  h1, h2, h3, h4 {\n    font-family: var(--font-heading);\n    margin: 0;\n  }\n\n  .swiss-grid {\n    display: grid;\n    grid-template-columns: repeat(12, 1fr);\n    gap: 24px;\n    max-width: 1440px;\n    margin: 0 auto;\n    padding: 0 40px;\n  }\n\n  .border-hairline {\n    border-bottom: 1px solid var(--color-text);\n  }\n\n  /* Marquee Logic */\n  .marquee-container {\n    overflow: hidden;\n    white-space: nowrap;\n    position: relative;\n  }\n  .marquee-track {\n    display: inline-flex;\n    gap: 80px;\n    align-items: center;\n  }\n</style>\n\n<div class=\"min-h-screen\" data-kid=\"1\">\n  \n  <nav class=\"sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-[#2A3439]/10\" data-kid=\"2\">\n    <div class=\"swiss-grid py-6 items-center\" data-kid=\"3\">\n      <div class=\"col-span-3 flex items-center gap-2 group cursor-pointer\" data-kid=\"4\">\n        <div class=\"w-10 h-10 bg-[#2A3439] flex items-center justify-center text-white font-bold text-xl\" data-kid=\"5\">M</div>\n        <span class=\"font-heading font-extrabold tracking-tighter text-2xl\" data-kid=\"6\">MEDLABEL<span class=\"font-normal text-[#2A3439]/60\" data-kid=\"7\">VERIFY</span></span>\n      </div>\n      <div class=\"col-span-6 flex justify-center gap-12 font-medium text-sm tracking-wide uppercase\" data-kid=\"8\">\n        <a href=\"#\" class=\"hover:text-[#00356B]\" data-kid=\"9\">Platform</a>\n        <a href=\"#\" class=\"hover:text-[#00356B]\" data-kid=\"10\">Compliance Standards</a>\n        <a href=\"#\" class=\"hover:text-[#00356B]\" data-kid=\"11\">Documentation</a>\n        <a href=\"#\" class=\"hover:text-[#00356B]\" data-kid=\"12\">Company</a>\n      </div>\n      <div class=\"col-span-3 flex justify-end\" data-kid=\"13\">\n        <button class=\"bg-[#00356B] text-white px-6 py-3 font-heading font-semibold text-sm tracking-tight hover:bg-[#002855]\" data-kid=\"14\">\n          Request Technical Audit\n        </button>\n      </div>\n    </div>\n  </nav>\n\n  \n  <header class=\"pt-24 pb-32 overflow-hidden\" data-kid=\"15\">\n    <div class=\"swiss-grid items-center\" data-kid=\"16\">\n      <div class=\"col-span-7\" id=\"hero-text-content\" data-kid=\"17\">\n        <div class=\"mb-8 flex items-center gap-3\" data-kid=\"18\">\n          <span class=\"px-2 py-1 border border-[#2A3439] text-[10px] font-bold uppercase tracking-widest\" data-kid=\"19\">Global Standards</span>\n          <span class=\"text-xs font-medium text-[#2A3439]/50 uppercase tracking-widest\" data-kid=\"20\">Regulatory Compliance Platform v4.2</span>\n        </div>\n        <h1 class=\"text-[84px] leading-[0.9] font-extrabold tracking-tighter mb-8 text-[#2A3439]\" data-kid=\"21\">\n          Absolute Compliance.<br data-kid=\"22\">\n          <span class=\"text-[#00356B]\" data-kid=\"23\">Zero Margin</span> for Error.\n        </h1>\n        <p class=\"text-xl leading-relaxed text-[#2A3439]/80 max-w-xl mb-12 font-light\" data-kid=\"24\">\n          Verify medical device labels against the world’s strictest regulations in seconds. Our platform provides deterministic verification for FDA, MHRA, CDSCO, and PMDA requirements.\n        </p>\n        <div class=\"flex items-center gap-8\" data-kid=\"25\">\n          <button class=\"bg-[#2A3439] text-white px-10 py-5 font-heading font-bold text-base hover:bg-black\" data-kid=\"26\">\n            Start Verification\n          </button>\n          <div class=\"flex items-center gap-3 text-sm font-semibold group cursor-pointer\" data-kid=\"27\">\n            <span class=\"border-b-2 border-[#2A3439] pb-0.5 group-hover:text-[#00356B] group-hover:border-[#00356B]\" data-kid=\"28\">View Compliance Framework</span>\n            <i class=\"ti ti-arrow-right text-lg\" data-kid=\"29\"></i>\n          </div>\n        </div>\n      </div>\n      <div class=\"col-span-5 relative\" data-kid=\"30\">\n        <div class=\"relative z-10 p-4 border border-[#2A3439]/10 bg-white\" id=\"hero-image-container\" data-kid=\"31\">\n          <img src=\"https://images.unsplash.com/photo-1721329567529-b6bc1d93fce2?auto=format&w=800&q=80&fit=crop\" alt=\"Pharmaceutical label macro scan\" class=\"w-full h-[600px] object-cover grayscale contrast-125\" decoding=\"async\" loading=\"lazy\" data-kid=\"32\">\n          <div class=\"absolute inset-0 bg-navy-900/10 mix-blend-multiply\" data-kid=\"33\"></div>\n          \n          \n          <div class=\"absolute top-1/2 left-0 w-full h-[2px] bg-[#00356B] shadow-[0_0_15px_rgba(0,53,107,0.8)] z-20\" id=\"scan-line\" data-kid=\"34\"></div>\n          <div class=\"absolute top-10 right-10 p-4 bg-white/90 backdrop-blur border border-[#2A3439] z-20\" data-kid=\"35\">\n            <div class=\"text-[10px] font-bold uppercase tracking-tighter mb-1\" data-kid=\"36\">OCR Status</div>\n            <div class=\"flex items-center gap-2\" data-kid=\"37\">\n              <div class=\"w-2 h-2 rounded-full bg-green-500 animate-pulse\" data-kid=\"38\"></div>\n              <span class=\"text-xs font-mono font-bold\" data-kid=\"39\">ACTIVE_VALIDATION</span>\n            </div>\n          </div>\n        </div>\n        \n        <div class=\"absolute -top-20 -right-20 w-80 h-80 opacity-5 pointer-events-none\" style=\"background-image: radial-gradient(#2A3439 1px, transparent 1px); background-size: 20px 20px;\" data-kid=\"40\"></div>\n      </div>\n    </div>\n  </header>\n\n  \n  <section class=\"py-16 border-t border-b border-[#2A3439]/10 bg-[#FAFAFA]\" data-kid=\"41\">\n    <div class=\"swiss-grid mb-10\" data-kid=\"42\">\n      <div class=\"col-span-12\" data-kid=\"43\">\n        <span class=\"text-[10px] font-bold uppercase tracking-[0.3em] text-[#2A3439]/40\" data-kid=\"44\">Trusted by Global Manufacturers</span>\n      </div>\n    </div>\n    <div class=\"marquee-container w-full\" data-kid=\"45\">\n      <div class=\"marquee-track\" data-kid=\"46\">\n        \n        <div class=\"flex items-center gap-20 px-10 grayscale opacity-40 hover:opacity-100 transition-opacity\" data-kid=\"47\">\n          <span class=\"text-2xl font-heading font-black tracking-tighter\" data-kid=\"48\">PHARMA<span class=\"font-light\" data-kid=\"49\">CORP</span></span>\n          <span class=\"text-2xl font-heading font-black tracking-tighter\" data-kid=\"50\">MED<span class=\"font-light\" data-kid=\"51\">SYSTEMS</span></span>\n          <span class=\"text-2xl font-heading font-black tracking-tighter\" data-kid=\"52\">BIO<span class=\"font-light\" data-kid=\"53\">VAL</span></span>\n          <span class=\"text-2xl font-heading font-black tracking-tighter\" data-kid=\"54\">GEN<span class=\"font-light\" data-kid=\"55\">TECH</span></span>\n          <span class=\"text-2xl font-heading font-black tracking-tighter\" data-kid=\"56\">LAB<span class=\"font-light\" data-kid=\"57\">CORE</span></span>\n          <span class=\"text-2xl font-heading font-black tracking-tighter\" data-kid=\"58\">VITA<span class=\"font-light\" data-kid=\"59\">STRUX</span></span>\n        </div>\n        <div class=\"flex items-center gap-20 px-10 grayscale opacity-40 hover:opacity-100 transition-opacity\" data-kid=\"60\">\n          <span class=\"text-2xl font-heading font-black tracking-tighter\" data-kid=\"61\">PHARMA<span class=\"font-light\" data-kid=\"62\">CORP</span></span>\n          <span class=\"text-2xl font-heading font-black tracking-tighter\" data-kid=\"63\">MED<span class=\"font-light\" data-kid=\"64\">SYSTEMS</span></span>\n          <span class=\"text-2xl font-heading font-black tracking-tighter\" data-kid=\"65\">BIO<span class=\"font-light\" data-kid=\"66\">VAL</span></span>\n          <span class=\"text-2xl font-heading font-black tracking-tighter\" data-kid=\"67\">GEN<span class=\"font-light\" data-kid=\"68\">TECH</span></span>\n          <span class=\"text-2xl font-heading font-black tracking-tighter\" data-kid=\"69\">LAB<span class=\"font-light\" data-kid=\"70\">CORE</span></span>\n          <span class=\"text-2xl font-heading font-black tracking-tighter\" data-kid=\"71\">VITA<span class=\"font-light\" data-kid=\"72\">STRUX</span></span>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32\" data-kid=\"73\">\n    <div class=\"swiss-grid mb-20\" data-kid=\"74\">\n      <div class=\"col-span-5\" data-kid=\"75\">\n        <h2 class=\"text-5xl font-extrabold tracking-tight leading-none mb-6\" data-kid=\"76\">Core Verification<br data-kid=\"77\">Capabilities</h2>\n        <p class=\"text-lg text-[#2A3439]/60 font-light\" data-kid=\"78\">Deterministic rulesets applied to every scan.</p>\n      </div>\n    </div>\n    <div class=\"swiss-grid\" data-kid=\"79\">\n      <div class=\"col-span-12 border-t border-[#2A3439] capability-row\" data-kid=\"80\">\n        \n        <div class=\"grid grid-cols-12 py-4 text-[10px] font-bold uppercase tracking-widest text-[#2A3439]/40\" data-kid=\"81\">\n          <div class=\"col-span-1\" data-kid=\"82\">ID</div>\n          <div class=\"col-span-4\" data-kid=\"83\">Capability</div>\n          <div class=\"col-span-4\" data-kid=\"84\">Technical Parameter</div>\n          <div class=\"col-span-3 text-right\" data-kid=\"85\">Accuracy Metric</div>\n        </div>\n        \n        \n        <div class=\"grid grid-cols-12 py-8 border-t border-[#2A3439]/10 items-center hover:bg-[#F8F9FA] transition-colors group\" data-kid=\"86\">\n          <div class=\"col-span-1 font-mono text-sm\" data-kid=\"87\">01</div>\n          <div class=\"col-span-4 font-heading font-bold text-xl group-hover:text-[#00356B]\" data-kid=\"88\">FDA Guideline Matching</div>\n          <div class=\"col-span-4 text-sm font-medium text-[#2A3439]/70\" data-kid=\"89\">CFR 21 Part 801 compliance validation</div>\n          <div class=\"col-span-3 text-right font-heading font-extrabold text-2xl\" data-kid=\"90\">100%</div>\n        </div>\n\n        \n        <div class=\"grid grid-cols-12 py-8 border-t border-[#2A3439]/10 items-center hover:bg-[#F8F9FA] transition-colors group\" data-kid=\"91\">\n          <div class=\"col-span-1 font-mono text-sm\" data-kid=\"92\">02</div>\n          <div class=\"col-span-4 font-heading font-bold text-xl group-hover:text-[#00356B]\" data-kid=\"93\">Barcode Integrity Analysis</div>\n          <div class=\"col-span-4 text-sm font-medium text-[#2A3439]/70\" data-kid=\"94\">ISO/IEC 15416 print quality grading</div>\n          <div class=\"col-span-3 text-right font-heading font-extrabold text-2xl\" data-kid=\"95\">Grade A</div>\n        </div>\n\n        \n        <div class=\"grid grid-cols-12 py-8 border-t border-[#2A3439]/10 items-center hover:bg-[#F8F9FA] transition-colors group\" data-kid=\"96\">\n          <div class=\"col-span-1 font-mono text-sm\" data-kid=\"97\">03</div>\n          <div class=\"col-span-4 font-heading font-bold text-xl group-hover:text-[#00356B]\" data-kid=\"98\">Typography Verification</div>\n          <div class=\"col-span-4 text-sm font-medium text-[#2A3439]/70\" data-kid=\"99\">Minimum point size & legibility checks</div>\n          <div class=\"col-span-3 text-right font-heading font-extrabold text-2xl\" data-kid=\"100\">< 0.1mm</div>\n        </div>\n\n        \n        <div class=\"grid grid-cols-12 py-8 border-t border-[#2A3439]/10 border-b border-[#2A3439] items-center hover:bg-[#F8F9FA] transition-colors group\" data-kid=\"101\">\n          <div class=\"col-span-1 font-mono text-sm\" data-kid=\"102\">04</div>\n          <div class=\"col-span-4 font-heading font-bold text-xl group-hover:text-[#00356B]\" data-kid=\"103\">Global UDI Sync</div>\n          <div class=\"col-span-4 text-sm font-medium text-[#2A3439]/70\" data-kid=\"104\">GUDID and EUDAMED database cross-ref</div>\n          <div class=\"col-span-3 text-right font-heading font-extrabold text-2xl\" data-kid=\"105\">Real-time</div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32 bg-[#2A3439] text-white\" data-kid=\"106\">\n    <div class=\"swiss-grid mb-24\" data-kid=\"107\">\n      <div class=\"col-span-6\" data-kid=\"108\">\n        <h2 class=\"text-6xl font-extrabold tracking-tighter mb-8 leading-none\" data-kid=\"109\">The Verification Pipeline</h2>\n        <p class=\"text-xl font-light text-white/60\" data-kid=\"110\">Institutional-grade rigor at every stage of the process.</p>\n      </div>\n    </div>\n    \n    <div class=\"swiss-grid\" data-kid=\"111\">\n      <div class=\"col-span-8 col-start-3 relative py-10\" id=\"timeline-container\" data-kid=\"112\">\n        \n        <div class=\"absolute left-4 top-0 bottom-0 w-[1px] bg-white/20\" data-kid=\"113\">\n          <div class=\"absolute top-0 left-0 w-full bg-[#00356B] h-0\" id=\"timeline-progress\" data-kid=\"114\"></div>\n        </div>\n\n        \n        <div class=\"relative pl-20 mb-24 timeline-step\" data-kid=\"115\">\n          <div class=\"absolute left-2.5 top-0 w-3 h-3 bg-white border-4 border-[#2A3439] outline outline-1 outline-white rounded-full z-10\" data-kid=\"116\"></div>\n          <div class=\"max-w-xl\" data-kid=\"117\">\n            <span class=\"text-[10px] font-bold uppercase tracking-widest text-[#00356B] bg-white px-2 py-0.5 mb-4 inline-block\" data-kid=\"118\">Phase 01</span>\n            <h3 class=\"text-3xl font-bold mb-4\" data-kid=\"119\">Ingestion & Pre-processing</h3>\n            <p class=\"text-lg font-light text-white/70 leading-relaxed\" data-kid=\"120\">\n              Native PDF or high-resolution imagery is ingested via encrypted API. Multi-spectrum noise reduction ensures clinical-grade legibility for downstream OCR.\n            </p>\n          </div>\n        </div>\n\n        \n        <div class=\"relative pl-20 mb-24 timeline-step\" data-kid=\"121\">\n          <div class=\"absolute left-2.5 top-0 w-3 h-3 bg-white border-4 border-[#2A3439] outline outline-1 outline-white rounded-full z-10\" data-kid=\"122\"></div>\n          <div class=\"max-w-xl\" data-kid=\"123\">\n            <span class=\"text-[10px] font-bold uppercase tracking-widest text-[#00356B] bg-white px-2 py-0.5 mb-4 inline-block\" data-kid=\"124\">Phase 02</span>\n            <h3 class=\"text-3xl font-bold mb-4\" data-kid=\"125\">Parameter Extraction</h3>\n            <p class=\"text-lg font-light text-white/70 leading-relaxed\" data-kid=\"126\">\n              Proprietary vision models extract device names, manufacturer details, lot numbers, symbols, and UDI strings with 99.9% accuracy.\n            </p>\n          </div>\n        </div>\n\n        \n        <div class=\"relative pl-20 mb-24 timeline-step\" data-kid=\"127\">\n          <div class=\"absolute left-2.5 top-0 w-3 h-3 bg-white border-4 border-[#2A3439] outline outline-1 outline-white rounded-full z-10\" data-kid=\"128\"></div>\n          <div class=\"max-w-xl\" data-kid=\"129\">\n            <span class=\"text-[10px] font-bold uppercase tracking-widest text-[#00356B] bg-white px-2 py-0.5 mb-4 inline-block\" data-kid=\"130\">Phase 03</span>\n            <h3 class=\"text-3xl font-bold mb-4\" data-kid=\"131\">Regulatory Cross-Check</h3>\n            <p class=\"text-lg font-light text-white/70 leading-relaxed\" data-kid=\"132\">\n              Extracted data points are compared against a real-time updated library of 24,000+ national regulatory requirements.\n            </p>\n          </div>\n        </div>\n\n        \n        <div class=\"relative pl-20 timeline-step\" data-kid=\"133\">\n          <div class=\"absolute left-2.5 top-0 w-3 h-3 bg-white border-4 border-[#2A3439] outline outline-1 outline-white rounded-full z-10\" data-kid=\"134\"></div>\n          <div class=\"max-w-xl\" data-kid=\"135\">\n            <span class=\"text-[10px] font-bold uppercase tracking-widest text-[#00356B] bg-white px-2 py-0.5 mb-4 inline-block\" data-kid=\"136\">Phase 04</span>\n            <h3 class=\"text-3xl font-bold mb-4\" data-kid=\"137\">Compliance Certification</h3>\n            <p class=\"text-lg font-light text-white/70 leading-relaxed\" data-kid=\"138\">\n              A cryptographically signed compliance report is generated, detailing specific passes or flags for each target jurisdiction.\n            </p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-32\" data-kid=\"139\">\n    <div class=\"swiss-grid items-center\" data-kid=\"140\">\n      <div class=\"col-span-6\" data-kid=\"141\">\n        <div class=\"p-12 bg-white border border-[#2A3439] relative overflow-hidden\" data-kid=\"142\">\n          <h3 class=\"text-sm font-bold uppercase tracking-widest mb-10\" data-kid=\"143\">Efficiency Gain Analysis</h3>\n          \n          \n          <div class=\"flex items-end gap-4 h-64 mb-8\" data-kid=\"144\">\n            <div class=\"flex-1 bg-[#2A3439]/5 h-full relative flex items-end\" data-kid=\"145\">\n              <div class=\"w-full bg-[#2A3439]/20 h-[80%]\" id=\"bar-1\" data-kid=\"146\"></div>\n              <div class=\"absolute -top-6 left-0 w-full text-center text-[10px] font-bold\" data-kid=\"147\">Manual Audit</div>\n            </div>\n            <div class=\"flex-1 bg-[#2A3439]/5 h-full relative flex items-end\" data-kid=\"148\">\n              <div class=\"w-full bg-[#00356B] h-[12%]\" id=\"bar-2\" data-kid=\"149\"></div>\n              <div class=\"absolute -top-6 left-0 w-full text-center text-[10px] font-bold text-[#00356B]\" data-kid=\"150\">MLV Audit</div>\n            </div>\n          </div>\n          \n          <div class=\"flex justify-between items-center pt-8 border-t border-[#2A3439]/10\" data-kid=\"151\">\n            <div class=\"text-xs font-medium text-[#2A3439]/60\" data-kid=\"152\">Average audit time reduction</div>\n            <div class=\"text-4xl font-extrabold tracking-tighter\" id=\"stat-reduction\" data-kid=\"153\">88%</div>\n          </div>\n          \n          \n          <div class=\"absolute bottom-0 right-0 w-24 h-24 bg-[#00356B]/5 rounded-tl-full\" data-kid=\"154\"></div>\n        </div>\n      </div>\n      \n      <div class=\"col-span-5 col-start-8\" data-kid=\"155\">\n        <div class=\"space-y-6\" data-kid=\"156\">\n          <div class=\"p-8 border-l-4 border-[#2A3439] bg-[#F8F9FA]\" data-kid=\"157\">\n            <div class=\"text-[10px] font-bold uppercase tracking-[0.2em] mb-2\" data-kid=\"158\">Accuracy Rate</div>\n            <div class=\"text-5xl font-extrabold tracking-tighter mb-4\" id=\"stat-accuracy\" data-kid=\"159\">99.99%</div>\n            <p class=\"text-sm text-[#2A3439]/60 leading-relaxed\" data-kid=\"160\">Our computer vision engine is trained on over 2 million verified medical device labels.</p>\n          </div>\n          <div class=\"p-8 border-l-4 border-[#00356B] bg-[#F8F9FA]\" data-kid=\"161\">\n            <div class=\"text-[10px] font-bold uppercase tracking-[0.2em] mb-2\" data-kid=\"162\">Processing Latency</div>\n            <div class=\"text-5xl font-extrabold tracking-tighter mb-4\" id=\"stat-latency\" data-kid=\"163\">< 0.5s</div>\n            <p class=\"text-sm text-[#2A3439]/60 leading-relaxed\" data-kid=\"164\">Instant feedback loop for production printing facilities and regulatory teams.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"bg-white border-t-2 border-[#2A3439] pt-24 pb-12\" data-kid=\"165\">\n    <div class=\"swiss-grid pb-24 border-b border-[#2A3439]/10\" data-kid=\"166\">\n      <div class=\"col-span-4\" data-kid=\"167\">\n        <div class=\"flex items-center gap-2 mb-8\" data-kid=\"168\">\n          <div class=\"w-8 h-8 bg-[#2A3439] flex items-center justify-center text-white font-bold text-lg\" data-kid=\"169\">M</div>\n          <span class=\"font-heading font-extrabold tracking-tighter text-xl uppercase text-[#2A3439]\" data-kid=\"170\">MEDLABEL<span class=\"font-normal text-[#2A3439]/60\" data-kid=\"171\">VERIFY</span></span>\n        </div>\n        <p class=\"text-sm text-[#2A3439]/60 leading-relaxed max-w-xs mb-8\" data-kid=\"172\">\n          The institutional standard for medical device label verification and regulatory compliance automation.\n        </p>\n        <div class=\"flex gap-4\" data-kid=\"173\">\n          <a href=\"#\" class=\"w-10 h-10 border border-[#2A3439]/20 flex items-center justify-center hover:bg-[#2A3439] hover:text-white transition-colors\" data-kid=\"174\"><i class=\"ti ti-brand-linkedin\" data-kid=\"175\"></i></a>\n          <a href=\"#\" class=\"w-10 h-10 border border-[#2A3439]/20 flex items-center justify-center hover:bg-[#2A3439] hover:text-white transition-colors\" data-kid=\"176\"><i class=\"ti ti-brand-x\" data-kid=\"177\"></i></a>\n        </div>\n      </div>\n      \n      <div class=\"col-span-2\" data-kid=\"178\">\n        <h4 class=\"text-xs font-bold uppercase tracking-widest mb-8\" data-kid=\"179\">Platform</h4>\n        <ul class=\"space-y-4 text-sm font-medium text-[#2A3439]/60\" data-kid=\"180\">\n          <li data-kid=\"181\"><a href=\"#\" class=\"hover:text-[#00356B]\" data-kid=\"182\">Verification Engine</a></li>\n          <li data-kid=\"183\"><a href=\"#\" class=\"hover:text-[#00356B]\" data-kid=\"184\">Rules Library</a></li>\n          <li data-kid=\"185\"><a href=\"#\" class=\"hover:text-[#00356B]\" data-kid=\"186\">API Reference</a></li>\n          <li data-kid=\"187\"><a href=\"#\" class=\"hover:text-[#00356B]\" data-kid=\"188\">Security</a></li>\n        </ul>\n      </div>\n\n      <div class=\"col-span-2\" data-kid=\"189\">\n        <h4 class=\"text-xs font-bold uppercase tracking-widest mb-8\" data-kid=\"190\">Standards</h4>\n        <ul class=\"space-y-4 text-sm font-medium text-[#2A3439]/60\" data-kid=\"191\">\n          <li data-kid=\"192\"><a href=\"#\" class=\"hover:text-[#00356B]\" data-kid=\"193\">FDA (US)</a></li>\n          <li data-kid=\"194\"><a href=\"#\" class=\"hover:text-[#00356B]\" data-kid=\"195\">MHRA (UK)</a></li>\n          <li data-kid=\"196\"><a href=\"#\" class=\"hover:text-[#00356B]\" data-kid=\"197\">CDSCO (IN)</a></li>\n          <li data-kid=\"198\"><a href=\"#\" class=\"hover:text-[#00356B]\" data-kid=\"199\">PMDA (JP)</a></li>\n        </ul>\n      </div>\n\n      <div class=\"col-span-2\" data-kid=\"200\">\n        <h4 class=\"text-xs font-bold uppercase tracking-widest mb-8\" data-kid=\"201\">Company</h4>\n        <ul class=\"space-y-4 text-sm font-medium text-[#2A3439]/60\" data-kid=\"202\">\n          <li data-kid=\"203\"><a href=\"#\" class=\"hover:text-[#00356B]\" data-kid=\"204\">About</a></li>\n          <li data-kid=\"205\"><a href=\"#\" class=\"hover:text-[#00356B]\" data-kid=\"206\">Compliance Trust</a></li>\n          <li data-kid=\"207\"><a href=\"#\" class=\"hover:text-[#00356B]\" data-kid=\"208\">Contact</a></li>\n          <li data-kid=\"209\"><a href=\"#\" class=\"hover:text-[#00356B]\" data-kid=\"210\">Careers</a></li>\n        </ul>\n      </div>\n\n      <div class=\"col-span-2\" data-kid=\"211\">\n        <h4 class=\"text-xs font-bold uppercase tracking-widest mb-8\" data-kid=\"212\">Legal</h4>\n        <ul class=\"space-y-4 text-sm font-medium text-[#2A3439]/60\" data-kid=\"213\">\n          <li data-kid=\"214\"><a href=\"#\" class=\"hover:text-[#00356B]\" data-kid=\"215\">Privacy Policy</a></li>\n          <li data-kid=\"216\"><a href=\"#\" class=\"hover:text-[#00356B]\" data-kid=\"217\">Terms of Service</a></li>\n          <li data-kid=\"218\"><a href=\"#\" class=\"hover:text-[#00356B]\" data-kid=\"219\">Audit Rights</a></li>\n        </ul>\n      </div>\n    </div>\n    \n    <div class=\"swiss-grid pt-12\" data-kid=\"220\">\n      <div class=\"col-span-6 text-xs font-medium text-[#2A3439]/40 uppercase tracking-widest\" data-kid=\"221\">\n        &copy; 2026 MedLabel Verify INC. All rights reserved. Precision compliance technology.\n      </div>\n      <div class=\"col-span-6 text-right text-xs font-medium text-[#2A3439]/40 uppercase tracking-widest\" data-kid=\"222\">\n        System Status: <span class=\"text-green-500\" data-kid=\"223\">Operational</span> &middot; HQ: Zurich, Switzerland\n      </div>\n    </div>\n  </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"224\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"225\"></script>\n<script type=\"module\" data-kid=\"226\">\n  import { animate, scroll, inView } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n  \n  gsap.registerPlugin(ScrollTrigger);\n\n  // Hero Entry Animations\n  gsap.from('#hero-text-content > *', {\n    autoAlpha: 0,\n    y: 40,\n    duration: 1,\n    stagger: 0.1,\n    ease: \"power4.out\",\n    delay: 0.2\n  });\n\n  gsap.from('#hero-image-container', {\n    autoAlpha: 0,\n    filter: \"blur(20px)\",\n    scale: 1.05,\n    duration: 1.5,\n    ease: \"power2.out\"\n  });\n\n  // Scan line animation\n  gsap.to('#scan-line', {\n    top: '90%',\n    duration: 3,\n    repeat: -1,\n    yoyo: true,\n    ease: \"power1.inOut\"\n  });\n\n  // Logo Marquee (Anime-style logic using GSAP for robustness)\n  const marqueeTrack = document.querySelector('.marquee-track');\n  gsap.to(marqueeTrack, {\n    xPercent: -50,\n    duration: 20,\n    repeat: -1,\n    ease: \"none\"\n  });\n\n  // Capability Ledger Row Animations\n  ScrollTrigger.batch('.capability-row > div', {\n    start: 'top 85%',\n    onEnter: (elements) => {\n      gsap.from(elements, {\n        autoAlpha: 0,\n        y: 20,\n        stagger: 0.1,\n        duration: 0.6,\n        ease: \"power2.out\"\n      });\n    }\n  });\n\n  // Timeline progress drawing\n  gsap.to('#timeline-progress', {\n    height: '100%',\n    ease: \"none\",\n    scrollTrigger: {\n      trigger: '#timeline-container',\n      start: 'top 60%',\n      end: 'bottom 40%',\n      scrub: true\n    }\n  });\n\n  // Counter animations for metrics\n  function animateCounter(id, target) {\n    const el = document.getElementById(id);\n    const obj = { value: 0 };\n    gsap.to(obj, {\n      value: target,\n      duration: 2,\n      scrollTrigger: {\n        trigger: el,\n        start: 'top 90%'\n      },\n      onUpdate: () => {\n        if (id === 'stat-reduction' || id === 'stat-accuracy') {\n          el.textContent = obj.value.toFixed(id === 'stat-accuracy' ? 2 : 0) + '%';\n        } else {\n          el.textContent = '< ' + obj.value.toFixed(1) + 's';\n        }\n      }\n    });\n  }\n\n  animateCounter('stat-reduction', 88);\n  animateCounter('stat-accuracy', 99.99);\n  \n  // Bar chart animation\n  gsap.from('#bar-1, #bar-2', {\n    scaleY: 0,\n    transformOrigin: 'bottom',\n    duration: 1.5,\n    stagger: 0.2,\n    ease: \"expo.out\",\n    scrollTrigger: {\n      trigger: '#bar-1',\n      start: 'top 90%'\n    }\n  });\n\n</script>",
