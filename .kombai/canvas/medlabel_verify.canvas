      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=IBM+Plex+Sans:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    background-color: var(--k-color-bg-page);\n    color: var(--k-color-text-primary);\n    font-family: var(--k-font-family-body);\n    margin: 0;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  h1, h2, h3, h4 {\n    font-family: var(--k-font-family-heading);\n    margin: 0;\n  }\n\n  .swiss-grid {\n    display: grid;\n    grid-template-columns: repeat(12, 1fr);\n    gap: 24px;\n    max-width: 1440px;\n    margin: 0 auto;\n    padding: 0 40px;\n  }\n\n  /* Scan line animation overlay - now confined to progress container */\n  .scan-overlay {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    pointer-events: none;\n    overflow: hidden;\n    z-index: 5;\n  }\n  \n  .scan-line {\n    position: absolute;\n    left: 0;\n    width: 100%;\n    height: 1px;\n    background: var(--k-color-accent);\n    box-shadow: 0 0 8px var(--k-color-accent);\n    opacity: 0.4;\n  }\n\n  .font-mono {\n    font-family: 'IBM Plex Mono', monospace;\n  }\n\n  [data-gsap-hide] {\n    opacity: 1; /* GSAP will handle initial state */\n  }\n</style>\n\n<div class=\"min-h-screen\" data-kid=\"1\">\n  \n  <nav class=\"sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-[var(--k-color-primary)]/10\" data-kid=\"2\">\n    <div class=\"swiss-grid py-6 items-center\" data-kid=\"3\">\n      <div class=\"col-span-3 flex items-center gap-2 group cursor-pointer\" data-kid=\"4\">\n        <div class=\"w-10 h-10 bg-[var(--k-color-primary)] flex items-center justify-center text-white font-bold text-xl\" data-kid=\"5\">M</div>\n        <span class=\"font-heading font-extrabold tracking-tighter text-2xl uppercase\" data-kid=\"6\"