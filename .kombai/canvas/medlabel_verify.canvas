      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Encode+Sans:wght@400;600;700&family=Space+Grotesk:wght@300;400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --color-iron: #414A4C;\n    --color-sea-green: #20B2AA;\n  }\n\n  body {\n    background-color: #FFFFFF;\n    color: #000000;\n    font-family: 'Space Grotesk', sans-serif;\n    margin: 0;\n  }\n\n  h1, h2, h3, h4 {\n    font-family: 'Encode Sans', sans-serif;\n    letter-spacing: -0.02em;\n  }\n\n  .font-tech { font-family: 'Space Grotesk', monospace; }\n  \n  /* Feature matrix hairline rules */\n  .matrix-cell {\n    border-top: 1px solid #E5E7EB;\n    border-left: 1px solid #E5E7EB;\n  }\n  .matrix-cell:nth-child(-n+4) { border-top: none; }\n  .matrix-cell:nth-child(4n+1) { border-left: none; }\n\n  /* Connector for flow chain */\n  .connector-line {\n    height: 1px;\n    background: #414A4C;\n    flex-grow: 1;\n    position: relative;\n  }\n  .connector-line::after {\n    content: '';\n    position: absolute;\n    right: -4px;\n    top: -3px;\n    border-left: 6px solid #414A4C;\n    border-top: 4px solid transparent;\n    border-bottom: 4px solid transparent;\n  }\n\n  /* Custom Scrollbar for Terminal */\n  .terminal-content::-webkit-scrollbar { width: 6px; }\n  .terminal-content::-webkit-scrollbar-track { background: #1a1a1a; }\n  .terminal-content::-webkit-scrollbar-thumb { background: #333; }\n</style>\n\n<div class=\"min-h-screen\" data-kid=\"1\">\n  \n  <header class=\"flex items-center justify-between px-12 py-6 border-b border-gray-100\" data-kid=\"2\">\n    <div class=\"flex items-center gap-2\" data-kid=\"3\">\n      <div class=\"w-8 h-8 bg-black flex items-center justify-center text-white font-bold text-xs tracking-tighter\" data-kid=\"4\">MLV</div>\n      <span class=\"font-semibold tracking-tight text-lg\" data-kid=\"5\">MedLabel Verify</span>\n    </div>\n    <nav class=\"flex items-center gap-10 text-sm font-medium text-[var(--color-iron)]\" data-kid=\"6\">\n      <a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"7\">Infrastructure</a>\n      <a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"8\">Standards</a>\n      <a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"9\">Documentation</a>\n      <a href=\"#\" class=\"px-5 py-2 border border-black text-black hover:bg-black hover:text-white transition-all\" data-kid=\"10\">API Access</a>\n    </nav>\n  </header>\n\n  \n  <section class=\"px-12 pt-20 pb-32 max-w-7xl mx-auto\" data-kid=\"11\">\n    <div class=\"max-w-3xl mb-16\" data-kid=\"12\">\n      <h1 class=\"text-7xl font-bold leading-[0.9] mb-8\" data-kid=\"13\">Verify at the speed of production.</h1>\n      <p class=\"text-xl text-[var(--color-iron)] max-w-xl leading-relaxed\" data-kid=\"14\">\n        Autonomous label compliance for global medical manufacturing. Precision OCR combined with institutional regulatory logic.\n      </p>\n    </div>\n\n    \n    <div class=\"bg-gray-50 p-1 border border-gray-200 shadow-sm overflow-hidden\" id=\"hero-widget\" data-kid=\"15\">\n      <div class=\"bg-white border border-gray-200 flex flex-col md:flex-row\" data-kid=\"16\">\n        \n        <div class=\"md:w-3/5 p-8 border-r border-gray-100 relative group\" data-kid=\"17\">\n          <div class=\"flex items-center justify-between mb-6\" data-kid=\"18\">\n            <span class=\"text-[10px] font-bold uppercase tracking-[0.2em] text-[var(--color-iron)] flex items-center gap-2\" data-kid=\"19\">\n              <span class=\"w-1.5 h-1.5 rounded-full bg-[var(--color-sea-green)] animate-pulse\" data-kid=\"20\"></span>\n              Live Scan Buffer: 0x8F2A\n            </span>\n            <span class=\"text-[10px] font-tech text-gray-400\" data-kid=\"21\">FPS: 60.0 &middot; LATENCY: 0.42ms</span>\n          </div>\n          <div class=\"relative aspect-[16/9] bg-gray-900 overflow-hidden\" data-kid=\"22\">\n            <img src=\"https://images.unsplash.com/photo-1597153916858-39eb504c1c68?auto=format&w=1200&q=80&fit=crop\" alt=\"Medical label being scanned\" class=\"w-full h-full object-cover opacity-80\" decoding=\"async\" loading=\"lazy\" data-kid=\"23\">\n            \n            <div class=\"absolute inset-0 pointer-events-none bg-gradient-to-b from-transparent via-[var(--color-sea-green)]/10 to-transparent h-2 top-0\" id=\"scanline\" data-kid=\"24\"></div>\n            \n            <div class=\"absolute top-1/4 left-1/3 w-24 h-8 border border-[var(--color-sea-green)]/40 bg-[var(--color-sea-green)]/5\" data-kid=\"25\"></div>\n            <div class=\"absolute bottom-1/3 right-1/4 w-32 h-10 border border-[var(--color-sea-green)]/40 bg-[var(--color-sea-green)]/5\" data-kid=\"26\"></div>\n          </div>\n        </div>\n        \n        \n        <div class=\"md:w-2/5 p-8 flex flex-col justify-between\" data-kid=\"27\">\n          <div data-kid=\"28\">\n            <div class=\"flex items-baseline justify-between mb-8\" data-kid=\"29\">\n              <h3 class=\"text-3xl font-bold\" data-kid=\"30\">99.98%</h3>\n              <span class=\"text-xs font-semibold text-[var(--color-sea-green)] uppercase tracking-widest\" data-kid=\"31\">Confidence Score</span>\n            </div>\n            \n            <div class=\"space-y-4\" data-kid=\"32\">\n              <div class=\"flex items-center justify-between py-2 border-b border-gray-50\" data-kid=\"33\">\n                <span class=\"text-sm font-tech\" data-kid=\"34\">01_DEVICE_NAME</span>\n                <span class=\"text-[10px] font-bold px-2 py-0.5 bg-[var(--color-sea-green)]/10 text-[var(--color-sea-green)] uppercase\" data-kid=\"35\">Valid</span>\n              </div>\n              <div class=\"flex items-center justify-between py-2 border-b border-gray-50\" data-kid=\"36\">\n                <span class=\"text-sm font-tech\" data-kid=\"37\">02_MFR_ENTITY</span>\n                <span class=\"text-[10px] font-bold px-2 py-0.5 bg-[var(--color-sea-green)]/10 text-[var(--color-sea-green)] uppercase\" data-kid=\"38\">Valid</span>\n              </div>\n              <div class=\"flex items-center justify-between py-2 border-b border-gray-50\" data-kid=\"39\">\n                <span class=\"text-sm font-tech\" data-kid=\"40\">03_UDI_GS1_SYMBOL</span>\n                <span class=\"text-[10px] font-bold px-2 py-0.5 bg-[var(--color-sea-green)]/10 text-[var(--color-sea-green)] uppercase\" data-kid=\"41\">Valid</span>\n              </div>\n              <div class=\"flex items-center justify-between py-2 border-b border-gray-50\" data-kid=\"42\">\n                <span class=\"text-sm font-tech\" data-kid=\"43\">04_EXP_DATE_ISO</span>\n                <span class=\"text-[10px] font-bold px-2 py-0.5 bg-[var(--color-sea-green)]/10 text-[var(--color-sea-green)] uppercase\" data-kid=\"44\">Valid</span>\n              </div>\n              <div class=\"flex items-center justify-between py-2 border-b border-gray-50\" data-kid=\"45\">\n                <span class=\"text-sm font-tech\" data-kid=\"46\">05_STERILE_SYMBOL</span>\n                <span class=\"text-[10px] font-bold px-2 py-0.5 bg-amber-50 text-amber-600 uppercase\" data-kid=\"47\">Warning</span>\n              </div>\n            </div>\n          </div>\n          \n          <button class=\"w-full mt-8 bg-[var(--color-sea-green)] text-white py-4 font-bold text-sm tracking-widest uppercase hover:bg-black transition-colors\" data-kid=\"48\">\n            Generate Compliance PDF\n          </button>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"px-12 py-32 border-t border-gray-100\" data-kid=\"49\">\n    <div class=\"max-w-7xl mx-auto\" data-kid=\"50\">\n      <div class=\"flex flex-col md:flex-row gap-20 mb-20\" data-kid=\"51\">\n        <h2 class=\"text-5xl font-bold md:w-1/3 leading-tight\" data-kid=\"52\">Institutional verification parameters.</h2>\n        <p class=\"text-lg text-[var(--color-iron)] md:w-2/3 leading-relaxed\" data-kid=\"53\">\n          Our engine operates at the primitive level, verifying pixel-perfect alignment against FDA, MHRA, and CDSCO standards. No approximations, only deterministic results.\n        </p>\n      </div>\n\n      <div class=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 matrix-container\" data-kid=\"54\">\n        \n        <div class=\"matrix-cell p-10 hover:bg-gray-50 transition-colors opacity-0 reveal-item\" data-kid=\"55\">\n          <span class=\"text-[10px] font-bold text-[var(--color-iron)] block mb-4\" data-kid=\"56\">TYPOGRAPHY</span>\n          <h4 class=\"text-xl font-bold mb-3\" data-kid=\"57\">Font Geometry</h4>\n          <p class=\"text-sm text-gray-500 leading-relaxed\" data-kid=\"58\">Verification of font-face, weight, and stroke-width against required legibility indices.</p>\n        </div>\n        <div class=\"matrix-cell p-10 hover:bg-gray-50 transition-colors opacity-0 reveal-item\" data-kid=\"59\">\n          <span class=\"text-[10px] font-bold text-[var(--color-iron)] block mb-4\" data-kid=\"60\">SYMBOLOGY</span>\n          <h4 class=\"text-xl font-bold mb-3\" data-kid=\"61\">ISO 15223-1</h4>\n          <p class=\"text-sm text-gray-500 leading-relaxed\" data-kid=\"62\">Validation of medical symbols including sterile barriers, biological risks, and temperature limits.</p>\n        </div>\n        <div class=\"matrix-cell p-10 hover:bg-gray-50 transition-colors opacity-0 reveal-item\" data-kid=\"63\">\n          <span class=\"text-[10px] font-bold text-[var(--color-iron)] block mb-4\" data-kid=\"64\">PHARMACODE</span>\n          <h4 class=\"text-xl font-bold mb-3\" data-kid=\"65\">Laetus Code</h4>\n          <p class=\"text-sm text-gray-500 leading-relaxed\" data-kid=\"66\">Sub-millisecond decoding of Laetus Pharmacode for packaging identity verification.</p>\n        </div>\n        <div class=\"matrix-cell p-10 hover:bg-gray-50 transition-colors opacity-0 reveal-item\" data-kid=\"67\">\n          <span class=\"text-[10px] font-bold text-[var(--color-iron)] block mb-4\" data-kid=\"68\">SERIALIZATION</span>\n          <h4 class=\"text-xl font-bold mb-3\" data-kid=\"69\">UDI & GTIN</h4>\n          <p class=\"text-sm text-gray-500 leading-relaxed\" data-kid=\"70\">Cross-checking of Unique Device Identifiers against global regulatory databases.</p>\n        </div>\n        \n        <div class=\"matrix-cell p-10 hover:bg-gray-50 transition-colors opacity-0 reveal-item\" data-kid=\"71\">\n          <span class=\"text-[10px] font-bold text-[var(--color-iron)] block mb-4\" data-kid=\"72\">CONTRAST</span>\n          <h4 class=\"text-xl font-bold mb-3\" data-kid=\"73\">Luminance Ratio</h4>\n          <p class=\"text-sm text-gray-500 leading-relaxed\" data-kid=\"74\">Automated checking of foreground/background contrast ratios for clinical safety.</p>\n        </div>\n        <div class=\"matrix-cell p-10 hover:bg-gray-50 transition-colors opacity-0 reveal-item\" data-kid=\"75\">\n          <span class=\"text-[10px] font-bold text-[var(--color-iron)] block mb-4\" data-kid=\"76\">MULTILINGUAL</span>\n          <h4 class=\"text-xl font-bold mb-3\" data-kid=\"77\">Translation Parity</h4>\n          <p class=\"text-sm text-gray-500 leading-relaxed\" data-kid=\"78\">Ensuring critical warning parity across 28+ required international languages.</p>\n        </div>\n        <div class=\"matrix-cell p-10 hover:bg-gray-50 transition-colors opacity-0 reveal-item\" data-kid=\"79\">\n          <span class=\"text-[10px] font-bold text-[var(--color-iron)] block mb-4\" data-kid=\"80\">BARCODE</span>\n          <h4 class=\"text-xl font-bold mb-3\" data-kid=\"81\">Degradation Test</h4>\n          <p class=\"text-sm text-gray-500 leading-relaxed\" data-kid=\"82\">Simulated scanning under low-light and damaged conditions for rugged verification.</p>\n        </div>\n        <div class=\"matrix-cell p-10 hover:bg-gray-50 transition-colors opacity-0 reveal-item\" data-kid=\"83\">\n          <span class=\"text-[10px] font-bold text-[var(--color-iron)] block mb-4\" data-kid=\"84\">REGULATORY</span>\n          <h4 class=\"text-xl font-bold mb-3\" data-kid=\"85\">Rule Cross-Check</h4>\n          <p class=\"text-sm text-gray-500 leading-relaxed\" data-kid=\"86\">Instant mapping of label fields to specific clauses in FDA and EU MDR regulations.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"px-12 py-32 bg-gray-50 overflow-hidden\" data-kid=\"87\">\n    <div class=\"max-w-7xl mx-auto\" data-kid=\"88\">\n      <div class=\"text-center mb-24\" data-kid=\"89\">\n        <h2 class=\"text-5xl font-bold mb-6\" data-kid=\"90\">Seamless Infrastructure.</h2>\n        <p class=\"text-lg text-[var(--color-iron)] max-w-2xl mx-auto\" data-kid=\"91\">MedLabel-Verify sits directly between your system of record and the production line.</p>\n      </div>\n\n      <div class=\"flex items-center gap-4 diagram-container\" data-kid=\"92\">\n        \n        <div class=\"flex-none bg-white border border-gray-200 p-8 w-64 shadow-sm z-10\" data-kid=\"93\">\n          <div class=\"w-10 h-10 bg-gray-100 flex items-center justify-center mb-6\" data-kid=\"94\">\n            <i class=\"ti ti-database text-xl\" data-kid=\"95\"></i>\n          </div>\n          <h4 class=\"font-bold mb-2\" data-kid=\"96\">ERP / PLM</h4>\n          <p class=\"text-xs text-gray-500 font-tech\" data-kid=\"97\">SAP, Oracle, or Proprietary Data Sources</p>\n        </div>\n\n        <div class=\"connector-line\" data-kid=\"98\"></div>\n\n        \n        <div class=\"flex-none bg-black text-white p-8 w-80 shadow-xl z-10 relative\" data-kid=\"99\">\n          <div class=\"absolute -top-3 left-1/2 -translate-x-1/2 bg-[var(--color-sea-green)] text-[10px] px-2 py-0.5 font-bold uppercase tracking-widest\" data-kid=\"100\">Core Engine</div>\n          <div class=\"w-10 h-10 bg-white/10 flex items-center justify-center mb-6\" data-kid=\"101\">\n            <i class=\"ti ti-binary text-xl text-[var(--color-sea-green)]\" data-kid=\"102\"></i>\n          </div>\n          <h4 class=\"font-bold mb-2\" data-kid=\"103\">MedLabel-Verify</h4>\n          <p class=\"text-xs text-gray-400 font-tech\" data-kid=\"104\">API Verification & Compliance Logic</p>\n        </div>\n\n        <div class=\"connector-line\" data-kid=\"105\"></div>\n\n        \n        <div class=\"flex-none bg-white border border-gray-200 p-8 w-64 shadow-sm z-10\" data-kid=\"106\">\n          <div class=\"w-10 h-10 bg-gray-100 flex items-center justify-center mb-6\" data-kid=\"107\">\n            <i class=\"ti ti-printer text-xl\" data-kid=\"108\"></i>\n          </div>\n          <h4 class=\"font-bold mb-2\" data-kid=\"109\">Production</h4>\n          <p class=\"text-xs text-gray-500 font-tech\" data-kid=\"110\">Zebra, Domino, or Continuous Inkjet</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"px-12 py-32 max-w-7xl mx-auto grid md:grid-cols-2 gap-24 items-center\" data-kid=\"111\">\n    <div data-kid=\"112\">\n      <div class=\"inline-block px-3 py-1 bg-gray-100 text-[10px] font-bold uppercase tracking-widest mb-8 text-[var(--color-iron)]\" data-kid=\"113\">Developer Experience</div>\n      <h2 class=\"text-5xl font-bold mb-8\" data-kid=\"114\">Built for rigorous integration.</h2>\n      <p class=\"text-lg text-[var(--color-iron)] leading-relaxed mb-10\" data-kid=\"115\">\n        Our API is designed for reliability. Get structured, deterministic JSON responses that can be used to block production lines automatically if compliance falls below your custom threshold.\n      </p>\n      <ul class=\"space-y-4\" data-kid=\"116\">\n        <li class=\"flex items-start gap-4 text-sm font-tech\" data-kid=\"117\">\n          <i class=\"ti ti-check text-[var(--color-sea-green)] mt-1\" data-kid=\"118\"></i>\n          <span data-kid=\"119\">99.999% API Uptime SLA</span>\n        </li>\n        <li class=\"flex items-start gap-4 text-sm font-tech\" data-kid=\"120\">\n          <i class=\"ti ti-check text-[var(--color-sea-green)] mt-1\" data-kid=\"121\"></i>\n          <span data-kid=\"122\">Full SDK support for Java, C#, and Python</span>\n        </li>\n        <li class=\"flex items-start gap-4 text-sm font-tech\" data-kid=\"123\">\n          <i class=\"ti ti-check text-[var(--color-sea-green)] mt-1\" data-kid=\"124\"></i>\n          <span data-kid=\"125\">Regional data residency options</span>\n        </li>\n      </ul>\n    </div>\n\n    \n    <div class=\"bg-gray-900 rounded-lg overflow-hidden shadow-2xl border border-gray-800\" data-kid=\"126\">\n      <div class=\"bg-gray-800 px-4 py-3 flex items-center gap-2\" data-kid=\"127\">\n        <div class=\"flex gap-1.5\" data-kid=\"128\">\n          <div class=\"w-3 h-3 rounded-full bg-red-500/50\" data-kid=\"129\"></div>\n          <div class=\"w-3 h-3 rounded-full bg-amber-500/50\" data-kid=\"130\"></div>\n          <div class=\"w-3 h-3 rounded-full bg-emerald-500/50\" data-kid=\"131\"></div>\n        </div>\n        <div class=\"mx-auto text-[10px] font-tech text-gray-500 tracking-wider\" data-kid=\"132\">compliance_response.json</div>\n      </div>\n      <div class=\"p-8 font-tech text-sm leading-relaxed text-gray-400 terminal-content overflow-y-auto max-h-[400px]\" data-kid=\"133\">\n        <div class=\"mb-2\" data-kid=\"134\"><span class=\"text-emerald-400\" data-kid=\"135\">$</span> curl -X POST https://api.medlabel.io/v1/verify</div>\n        <div class=\"text-gray-500 mb-4\" data-kid=\"136\">{ \"label_id\": \"LBL_9912\", \"region\": \"US_FDA\" }</div>\n        <pre class=\"text-blue-300\" data-kid=\"137\">\n{\n  <span class=\"text-emerald-400\">\"status\"</span>: <span class=\"text-amber-400\">\"COMPLIANT\"</span>,\n  <span class=\"text-emerald-400\">\"score\"</span>: 0.9998,\n  <span class=\"text-emerald-400\">\"analysis\"</span>: {\n    <span class=\"text-emerald-400\">\"fields_extracted\"</span>: 24,\n    <span class=\"text-emerald-400\">\"rules_applied\"</span>: 182,\n    <span class=\"text-emerald-400\">\"violations\"</span>: 0,\n    <span class=\"text-emerald-400\">\"warnings\"</span>: [\n      {\n        <span class=\"text-emerald-400\">\"field\"</span>: <span class=\"text-amber-400\">\"STORAGE_COND\"</span>,\n        <span class=\"text-emerald-400\">\"msg\"</span>: <span class=\"text-amber-400\">\"ISO 15223-1:2021 update avail\"</span>\n      }\n    ]\n  },\n  <span class=\"text-emerald-400\">\"timestamp\"</span>: <span class=\"text-amber-400\">\"2026-06-13T08:27:00Z\"</span>,\n  <span class=\"text-emerald-400\">\"trace_id\"</span>: <span class=\"text-amber-400\">\"7c0-d517-810b989d\"</span>\n}</pre>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"px-12 py-32 border-t border-gray-100\" data-kid=\"138\">\n    <div class=\"max-w-4xl mx-auto\" data-kid=\"139\">\n      <div class=\"text-center mb-24\" data-kid=\"140\">\n        <h2 class=\"text-5xl font-bold mb-6\" data-kid=\"141\">Scale without friction.</h2>\n        <p class=\"text-lg text-[var(--color-iron)]\" data-kid=\"142\">Predictable, volume-based licensing for enterprise-grade verification.</p>\n      </div>\n\n      <div class=\"relative py-20\" id=\"pricing-ladder\" data-kid=\"143\">\n        \n        <div class=\"absolute left-0 right-0 h-0.5 bg-gray-100 top-1/2\" data-kid=\"144\"></div>\n        <div class=\"absolute h-0.5 bg-[var(--color-sea-green)] top-1/2 left-0 w-2/3 transition-all duration-700\" data-kid=\"145\"></div>\n        <div class=\"absolute w-6 h-6 rounded-full border-4 border-white bg-[var(--color-sea-green)] shadow-lg top-1/2 left-2/3 -translate-y-1/2 -translate-x-1/2 cursor-pointer z-10 transition-all duration-700\" id=\"ladder-knob\" data-kid=\"146\"></div>\n\n        <div class=\"flex flex-col gap-12 relative\" data-kid=\"147\">\n          \n          <div class=\"flex items-center justify-between group\" data-kid=\"148\">\n            <div class=\"flex flex-col\" data-kid=\"149\">\n              <span class=\"text-[10px] font-bold text-[var(--color-sea-green)] uppercase mb-1\" data-kid=\"150\">Standard</span>\n              <span class=\"text-3xl font-bold group-hover:pl-2 transition-all\" data-kid=\"151\">100k Scans / Month</span>\n            </div>\n            <div class=\"text-right\" data-kid=\"152\">\n              <span class=\"text-sm font-tech text-gray-400\" data-kid=\"153\">BASE INFRASTRUCTURE</span>\n            </div>\n          </div>\n          \n          <div class=\"flex items-center justify-between group\" data-kid=\"154\">\n            <div class=\"flex flex-col\" data-kid=\"155\">\n              <span class=\"text-[10px] font-bold text-[var(--color-sea-green)] uppercase mb-1\" data-kid=\"156\">Growth</span>\n              <span class=\"text-3xl font-bold group-hover:pl-2 transition-all\" data-kid=\"157\">1M Scans / Month</span>\n            </div>\n            <div class=\"text-right\" data-kid=\"158\">\n              <span class=\"text-sm font-tech text-gray-400\" data-kid=\"159\">DEDICATED INSTANCE</span>\n            </div>\n          </div>\n          \n          <div class=\"flex items-center justify-between group opacity-40\" data-kid=\"160\">\n            <div class=\"flex flex-col\" data-kid=\"161\">\n              <span class=\"text-[10px] font-bold text-gray-400 uppercase mb-1\" data-kid=\"162\">Enterprise</span>\n              <span class=\"text-3xl font-bold group-hover:pl-2 transition-all\" data-kid=\"163\">Unlimited Volume</span>\n            </div>\n            <div class=\"text-right\" data-kid=\"164\">\n              <span class=\"text-sm font-tech text-gray-400\" data-kid=\"165\">ON-PREMISE AIR-GAPPED</span>\n            </div>\n          </div>\n        </div>\n      </div>\n      \n      <div class=\"mt-16 text-center\" data-kid=\"166\">\n        <button class=\"bg-black text-white px-12 py-5 font-bold text-sm tracking-[0.2em] uppercase hover:bg-[var(--color-sea-green)] transition-all\" data-kid=\"167\">\n          Request Institutional Audit\n        </button>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"px-12 pt-32 pb-16 bg-white border-t border-gray-100 text-center\" data-kid=\"168\">\n    <div class=\"max-w-7xl mx-auto flex flex-col items-center\" data-kid=\"169\">\n      <div class=\"w-10 h-10 bg-black flex items-center justify-center text-white font-bold text-xs tracking-tighter mb-10\" data-kid=\"170\">MLV</div>\n      \n      <nav class=\"flex flex-wrap justify-center gap-x-12 gap-y-6 text-sm font-medium text-[var(--color-iron)] mb-16\" data-kid=\"171\">\n        <a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"172\">Infrastructure Status</a>\n        <a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"173\">Legal & Privacy</a>\n        <a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"174\">Trust Center</a>\n        <a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"175\">Documentation</a>\n        <a href=\"#\" class=\"hover:text-black transition-colors\" data-kid=\"176\">API Reference</a>\n      </nav>\n      \n      <div class=\"w-full h-px bg-gray-50 mb-10\" data-kid=\"177\"></div>\n      \n      <div class=\"flex flex-col md:flex-row justify-between w-full items-center gap-6\" data-kid=\"178\">\n        <span class=\"text-[10px] font-bold text-gray-400 uppercase tracking-widest\" data-kid=\"179\">ISO 27001 &middot; FDA CFR 21 PART 11 &middot; SOC 2 TYPE II</span>\n        <span class=\"text-xs text-gray-400\" data-kid=\"180\">&copy; 2026 MedLabel Verify Infrastructure. All rights reserved.</span>\n      </div>\n    </div>\n  </footer>\n</div>\n\n<script type=\"module\" data-kid=\"181\">\n  import { animate, inView, scroll } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n  // 1. Scanline animation\n  animate(\"#scanline\", { top: [\"0%\", \"100%\"] }, { duration: 3, repeat: Infinity, ease: \"linear\" });\n\n  // 2. Matrix Reveal Stagger\n  inView(\".matrix-container\", () => {\n    animate(\".reveal-item\", { opacity: 1, y: [20, 0] }, { duration: 0.6, stagger: 0.05, ease: \"easeOut\" });\n  });\n\n  // 3. Diagram Container Fade\n  inView(\".diagram-container\", () => {\n    animate(\".diagram-container > div\", { opacity: [0, 1], scale: [0.95, 1] }, { duration: 0.8, stagger: 0.2 });\n  });\n\n  // 4. Scroll tied velocity (simplified for demo)\n  scroll((progress) => {\n    const knob = document.getElementById('ladder-knob');\n    if (knob) {\n      // Logic for pricing ladder progress could go here\n    }\n  });\n\n</script>",
